  "universal_interface_envelope": {
    "request": ["contract_version", "trace_id", "source_module", "target_module", "operation", "parameters", "payload", "payload_format", "schema_id"],
    "response": ["ok", "status", "data", "data_format", "schema_id", "warnings", "evidence", "timing"],
    "error": ["error_code", "severity", "message", "retryable", "fallback_route", "evidence"],
    "supported_payload_formats": ["dict", "list", "JSON", "JSONL", "CSV", "Parquet", "Arrow", "DuckDB relation", "Pandas DataFrame", "Polars DataFrame", "bytes", "text", "path reference"]
  },
  "safe_fix_whitelist": [
    "ENC_UTF8_BOM",
    "FMT_TRAILING_WHITESPACE",
    "FMT_FINAL_NEWLINE",
    "FMT_MIXED_NEWLINES"
  ],
  "hash_state_machine": {
    "original": "create run-local proposal",
    "same_proposal": "restage or skip without canonical mutation",
    "different_source_hash": "fail expected-hash guard and create a new review item",
    "history": "append-only"
  },
  "root_policy": {
    "default_mother_root": "C:\\Users\\tonyk\\Downloads\\VeritasIntelligenceAnalytics",
