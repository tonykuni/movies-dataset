    "output_scope": "%LOCALAPPDATA%\\VIA\\CentralGovernanceRuns"
  },
  "forbidden_actions": [
    "canonical mutation",
    "automatic activation",
    "target module import or dot-source during analysis",
    "network access",
    "package installation or environment rebuild",
    "delete or rename",
    "high-risk Hydra automatic repair",
    "shared output file writes across lanes"
  ],
  "required_outputs_each_round": [
