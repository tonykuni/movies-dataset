    "STANDARD": {"downstream_horizon": 3, "validation_scope": ["syntax", "contract", "dependency", "security"]},
    "DEEP": {"downstream_horizon": 5, "validation_scope": ["syntax", "contract", "dependency", "security", "hydra", "downstream"]}
