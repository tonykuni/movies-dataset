  "lanes": [
    "L01_STRUCTURE_AST",
    "L02_CONTRACT_SSOT",
    "L03_DEPENDENCY_ROUTING",
    "L04_HYDRA_IDENTITY",
    "L05_SECURITY_GOVERNANCE",
    "L06_QUALITY_OPTIMIZATION"
