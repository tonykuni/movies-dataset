#!/bin/sh
# 多環境隔離重建計畫引擎(via_*/BASE 盤點→衝突風險因子→旁建隔離重建計畫→三鏡像測選→dry-run 反覆實測→GREEN 段出執行檔;零安裝零刪改)— 動態解析最新版(鐵律)
DIR="$(cd "$(dirname "$0")/.." && pwd)"
ER="$(ls "$DIR/supportive modules/registry"/CGC_MDL050_EnvRebuild_v0*.py "$DIR/supportive modules/registry"/via_env_rebuild_v0*.py 2>/dev/null | sort | tail -n 1)"
if [ -z "$ER" ]; then
  echo "  ✗ 引擎缺:via_env_rebuild_v0*.py 未尋獲(誠實)" >&2
  exit 2
fi
exec python3 "$ER" "$@"
