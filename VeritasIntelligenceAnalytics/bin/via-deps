#!/bin/sh
# 依賴衝突統包引擎(十械三防線+三鏡像:全景掃描/逆溯/樹狀/鏡像測速切源/場景編成/多版本矩陣;唯讀零改動)— 動態解析最新版(鐵律)
DIR="$(cd "$(dirname "$0")/.." && pwd)"
DS="$(ls "$DIR/supportive modules/registry"/via_dep_super_v0*.py 2>/dev/null | sort | tail -n 1)"
if [ -z "$DS" ]; then
  echo "  ✗ 引擎缺:via_dep_super_v0*.py 未尋獲(誠實)" >&2
  exit 2
fi
exec python3 "$DS" "$@"
