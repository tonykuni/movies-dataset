#!/bin/sh
# 教訓帳本引擎(LESSON-LEARNED:收割存證→矩陣+根因解法落 log→GOLDEN 基線)— 動態解析最新版(鐵律)
DIR="$(cd "$(dirname "$0")/.." && pwd)"
LS="$(ls "$DIR/supportive modules/registry"/via_lessons_v0*.py 2>/dev/null | sort | tail -n 1)"
[ -z "$LS" ] && { echo "  ✗ 引擎缺:via_lessons_v0*.py(誠實)" >&2; exit 2; }
exec python3 "$LS" "$@"
