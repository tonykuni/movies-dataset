{
  "_comment": "VIA Master Engine 參數. 一份 JSON 管全部 Python 引擎: 順序/開關/參數/整合接線. VMT_ROOT 環境變數覆寫 paths.vmt_root.",
  "paths": {
    "vmt_root": "",
    "engines_dir": "",
    "sbom_db": "superbom.duckdb",
    "parser": "VIA_SuperBOM_ContentParser_v0100.py"
  },
  "integration": {
    "_comment": "問卷 overrides -> 其他引擎的自動接線",
    "apply_survey_overrides": true,
    "overrides_glob": "data/overrides_*.json",
    "wire_convergence_thresholds": true,
    "wire_domain_keywords": true,
    "domain_keywords_out": "data/domain_keywords.json"
  },
  "stages": [
    {"id": "survey",      "enabled": true,  "script": "vmt_survey.py",                 "args": [],                          "desc": "問卷: 表單+答案評分->overrides"},
    {"id": "attach",      "enabled": true,  "script": "vmt_superbom_attach_router.py", "args": ["--parser", "{parser}", "--db", "{sbom_db}"], "desc": "接縫2: 附件->SuperBOM SSOT", "needs_db": true},
    {"id": "bridge_out",  "enabled": true,  "script": "vmt_superbom_bridge.py",        "args": ["--db", "{sbom_db}"],       "desc": "接縫1 OUT: Q01->VMT 追蹤", "needs_db": true},
    {"id": "reply",       "enabled": true,  "script": "vmt_reply_ingest.py",           "args": [],                          "desc": "回覆閉環: 下拉回覆->SSOT"},
    {"id": "bridge_in",   "enabled": true,  "script": "vmt_superbom_bridge.py",        "args": ["--db", "{sbom_db}", "--commit"], "desc": "接縫1 IN: DONE->G01 回寫", "needs_db": true},
    {"id": "convergence", "enabled": true,  "script": "vmt_convergence.py",            "args": [],                          "desc": "收斂: 信心+主動學習佇列"},
    {"id": "eventstream", "enabled": true,  "script": "vmt_superbom_eventstream.py",   "args": ["--db", "{sbom_db}"],       "desc": "接縫3: 跨系統事件流探勘", "needs_db": true},
    {"id": "mining",      "enabled": true,  "script": "vmt_process_mining.py",         "args": [],                          "desc": "流程探勘: DFG/瓶頸"},
    {"id": "planning",    "enabled": true,  "script": "vmt_planning_cpm.py",           "args": [],                          "desc": "規劃層: CPM 關鍵路徑/甘特"}
  ],
  "run": {
    "stop_on_error": false,
    "timeout_sec_per_stage": 180
  },
  "report": {
    "html": "reports/MasterRun.html",
    "state": "data/master_state.json"
  }
}
