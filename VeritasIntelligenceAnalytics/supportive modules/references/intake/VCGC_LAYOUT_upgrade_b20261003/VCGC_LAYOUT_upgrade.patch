+"""Contract tests for reuse and review; no production database or network."""
+from __future__ import annotations
+import importlib.util
+import json
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+# def 01_PARAMETERS
+HERE = Path(__file__).resolve().parent
+HUB_FILE = HERE.parent / "SUP_MDL743_GenericLayoutHub_v0101.py"
+VIA = HERE.parents[2]
+CONSOLE_FILE = VIA / "supportive modules/registry/CGC_MDL149_VeritasCentralGovernanceConsole_v0146.py"
+# ===== [VIA:ACCEL-BRIDGE:v0100] inherited canonical compatibility bridge =====
+try:
+    sys.path.insert(0, str(VIA / "supportive modules"))
+    import VIA_SuperAccel_Module as VIA_ACCEL
+except ImportError:
+    VIA_ACCEL = None
+# ===== [VIA:ACCEL-BRIDGE:END] =====
+
+
+def def_module(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+HUB = def_module(HUB_FILE, "test_layout_reuse_hub")
+CONSOLE = def_module(CONSOLE_FILE, "test_layout_reuse_console")
+
+
+def def_cell(row: int, column: int, box: list, text: str) -> dict:
+    return {"element_id": f"cell-{row}-{column}", "element_type": "TABLE", "subtype": "DATA",
+            "bbox_pt": box, "raw_text": text, "repaired_text": text, "zone": "BR",
+            "metadata": {"table_index": 1, "row": row, "column": column}, "reading_order": row}
+
+
+class LayoutReuseTests(unittest.TestCase):
+    def test_locked_sources_unchanged(self):
+        locks = HUB.def_locked_sources(HUB.def_policy())
+        self.assertGreaterEqual(len(locks), 10)
+        self.assertTrue(all(v["state"] == "UNCHANGED" for v in locks.values()))
+
+    def test_existing_package_is_the_only_layout_implementation(self):
+        self.assertEqual(HUB.gle().__file__, HUB._previous.gle().__file__)
+        self.assertTrue(callable(HUB.gle().analyze_document))
+        self.assertEqual(HUB.def_policy()["route"]["selected_adapters"],
+                         ["pdfplumber", "pymupdf", "pdfminer_six"])
+        self.assertFalse(HUB.def_policy()["adapter"]["allow_model_downloads"])
+        self.assertFalse(HUB.def_policy()["adapter"]["allow_cloud_backends"])
+
+    def test_bottom_cells_preserve_raw_value_and_coordinates(self):
+        cells = [def_cell(1, 1, [400, 700, 470, 715], "2025F"),
+                 def_cell(2, 1, [400, 715, 470, 730], "(1,234.50)")]
+        grouped = HUB.def_tables({"physical_page": 1, "elements": cells})
+        self.assertEqual(grouped[0]["cells"], cells)
+        svg = HUB.def_table_svg(grouped[0])
+        self.assertIn('viewBox="400 700 70 30"', svg)
+        self.assertIn('(1,234.50)', svg)
+
+    def test_merged_geometry_uses_source_rectangle(self):
+        table = {"cells": [def_cell(1, 1, [5, 5, 105, 25], "Annual report"),
+                            def_cell(2, 1, [5, 25, 55, 35], "EPS"),
+                            def_cell(2, 2, [55, 25, 105, 35], "5.07")]}
+        svg = HUB.def_table_svg(table)
+        self.assertIn('width="100" height="20"', svg)
+        self.assertEqual(svg.count('data-row="2"'), 2)
+
+    def test_render_retains_lower_information_and_later_tables(self):
+        element = def_cell(1, 1, [400, 700, 470, 715], "BOTTOM_INFO<&>")
+        element.update(element_type="TEXT", subtype="FOOTER", include_in_main_text=False)
+        annual = def_cell(1, 1, [5, 5, 70, 20], "2026F")
+        doc = {"filename": "A<&>.pdf", "state": "REVIEW", "layout": {"pages": [
+            {"physical_page": 1, "elements": [element]},
+            {"physical_page": 7, "elements": [annual]}]}}
+        with tempfile.TemporaryDirectory() as tmp:
+            out = Path(tmp) / "review.html"
+            HUB.def_render({"documents": [doc], "errors": []}, out)
+            text = out.read_text()
+            self.assertIn("BOTTOM_INFO&lt;&amp;&gt;", text)
+            self.assertIn('data-page="7"', text)
+            self.assertIn("2026F", text)
+            self.assertNotIn("A<&>.pdf", text)
+
+    def test_filename_order_is_stable_and_no_database_written(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp); src = root / "input"; src.mkdir()
+            for name in ["b.PDF", "A.pdf", "a.pdf"]:
+                (src / name).write_bytes(b"unit-test input; not sent to a PDF backend")
+            def result(path, out):
+                return {"filename": path.name, "state": "REVIEW", "cache_hit": False,
+                        "layout": {"pages": []}}
+            with patch.object(HUB, "def_analyze", side_effect=result):
+                data = HUB.def_run_batch(src, root / "out")
+            self.assertEqual([d["filename"] for d in data["documents"]], ["A.pdf", "a.pdf", "b.PDF"])
+            self.assertFalse(data["financial_database_written"])
+            self.assertEqual(list(root.rglob("*.duckdb")), [])
+
+    def test_cache_avoids_backend_and_core_calls(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp); folder = root / "documents/fixed"; folder.mkdir(parents=True)
+            image = folder / "page.png"
+            image.write_bytes(b"cache existence fixture")
+            (folder / "layout_review.json").write_text(json.dumps({"signature": "fixed", "cacheable": True,
+                "layout": {"pages": [{"image_path": str(image)}]}}))
+            with patch.object(HUB, "def_signature", return_value="fixed"), \
+                 patch.object(HUB._previous, "orchestrator", side_effect=AssertionError("cache must avoid extraction")):
+                self.assertTrue(HUB.def_analyze(Path("report.pdf"), root)["cache_hit"])
+
+    def test_missing_input_is_nodata(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            data = HUB.def_run_batch(Path(tmp) / "missing", Path(tmp) / "out")
+            self.assertEqual(data["state"], "NODATA")
+            self.assertEqual(data["documents"], [])
+
+    def test_native_geometry_retains_moved_information_zones(self):
+        page = {"physical_page": 1, "width": 600, "height": 800}
+        for box in ([10, 10, 70, 20], [420, 10, 480, 20], [420, 710, 480, 720]):
+            words = [{"page": 1, "bbox": box, "text": "2026F EPS 5.07", "metadata": {"font_size": 8}}]
+            output = HUB.def_native_svg(page, words)
+            self.assertIn("2026F EPS 5.07", output)
+            self.assertIn(f'x="{box[0]}" y="{box[1]}"', output)
+
+    def test_financial_matrix_preserves_zero_negative_and_empty(self):
+        output = HUB.def_financial_matrix({"Rows": [["2025F", "2026F", "2027F"], [0, "(1.20)", None]]})
+        self.assertIn("<td>0</td>", output)
+        self.assertIn("<td>(1.20)</td>", output)
+        self.assertIn("<td></td>", output)
+
+    def test_vcgc_gate_blocks_before_layout(self):
+        with patch.object(CONSOLE.body, "require_token_gate", return_value=2), \
+             patch.object(CONSOLE, "def_layout_command") as run:
+            self.assertEqual(CONSOLE.main(["layout"]), 2)
+            run.assert_not_called()
+
+    def test_vcgc_gate_order_and_arguments(self):
+        order = []
+        with patch.object(CONSOLE.body, "require_token_gate", side_effect=lambda: order.append("token") or 0), \
+             patch.object(CONSOLE.body, "policy_step", side_effect=lambda: order.append("policy") or 0), \
+             patch.object(CONSOLE.body, "env_step", side_effect=lambda: order.append("environment") or 0), \
+             patch.object(CONSOLE, "def_layout_command", return_value=2) as run:
+            self.assertEqual(CONSOLE.main(["layout", "--dir", "sample"]), 2)
+            self.assertEqual(order, ["token", "policy", "environment"])
+            run.assert_called_once_with(["--dir", "sample"])
+
+    def test_old_vcgc_route_is_unchanged(self):
+        before = sys.argv
+        with patch.object(CONSOLE.prev, "main", return_value=7) as run:
+            self.assertEqual(CONSOLE.main(["status"]), 7)
+            run.assert_called_once_with()
+        self.assertIs(sys.argv, before)
+
+
+if __name__ == "__main__":
+    unittest.main()
