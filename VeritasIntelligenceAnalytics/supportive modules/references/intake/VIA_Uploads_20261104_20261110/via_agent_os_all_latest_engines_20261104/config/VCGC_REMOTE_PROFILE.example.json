{
  "schema": "VIA_VCGC_REMOTE_PROFILE/1.0",
  "enabled": false,
  "transport": "streamable-http",
  "mcp_protocol_version": "2026-07-28",
  "endpoint": "https://VCGC_HOST/ACTUAL_MCP_PATH",
  "allowed_hosts": [
    "VCGC_HOST"
  ],
  "issuer_allowed_hosts": [
    "AUTH_HOST"
  ],
  "oauth": {
    "mode": "oauth2.1",
    "issuer_url": "https://AUTH_HOST/ACTUAL_ISSUER_PATH",
    "resource": "https://VCGC_HOST/ACTUAL_MCP_PATH",
    "scopes": [
      "<READ_ONLY_SCOPE>"
    ],
    "read_only_scopes": [
      "<READ_ONLY_SCOPE>"
    ]
  },
  "tls_verify": true,
  "allow_redirects": false,
  "write_tools_enabled": false,
  "allow_private_network": false,
  "timeout_seconds": 5,
  "data_scope": [
    "<APPROVED_REPOSITORY_OR_PROJECT_ID>",
    "<APPROVED_READ_ONLY_DATA_FIELDS>"
  ],
  "allowed_tools": [
    {
      "name": "<EXACT_READ_ONLY_TOOL_NAME>",
      "access": "read"
    }
  ],
  "ca_file": "",
  "certificate_sha256": ""
}
