+        merged.append(row)
+    table["rows"]=merged
+    table["header_paths"]=[" / ".join(dict.fromkeys(r[c]["text"] for r in merged[:table["header_count"]] if r[c]["text"])) for c in range(len(edges)-1)]
+    return table
