+    after=_previous.def_locked_sources(_previous.def_policy())
+    if locks!=after:raise RuntimeError("LOCK_MISMATCH after repair")
+    report["state"]="ERROR" if report["errors"] else "REVIEW" if report["documents"] else "NODATA"
