+def def_cell(words, row, column):
+    """No unconditional forward fill: blanks have no invented values."""
+    raw = " ".join(w["text"] for w in sorted(words,key=lambda w:w["bbox"][0]))
+    value = re.sub(r"\s+", " ", raw).strip()
