+HEADING_ROLES = ("REPORT_TITLE", "H1", "H2", "H3")
+NOISE_ROLES = ("RUNNING_HEADER", "PAGE_FOOTER", "END_MATTER")
+BRACKETS = {"(": ")", "（": "）", "「": "」", "『": "』", "[": "]", "【": "】"}
