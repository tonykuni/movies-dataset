+def _mod(pat: str):
+    p = sorted(REG.glob(pat))[-1]
+    spec = importlib.util.spec_from_file_location(p.stem, p)
+    m = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(m)
+    return m
+
