+        and "rail.inert=!open" in page and 'id="railBackdrop"' in page)
+    chk("④ 必要參數由任務契約動態顯示",
+        all(token in page for token in
+            ('data-codes="true"', 'data-range="true"', 'data-cats="true"',
+             "updateParameterVisibility", "syncInputSummary")))
+    chk("⑤ 右側七分頁、固定頁首與固定頁尾",
