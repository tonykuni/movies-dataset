+    done = [r["pct"] for r in rows if isinstance(r["pct"], (int, float))]
+    measured_mean = round(sum(done) / len(done), 1) if done else None
+    return {"rows": rows,
+            # 任一項缺可靠分母時，不把已知子集均值冒充全系統完成度。
