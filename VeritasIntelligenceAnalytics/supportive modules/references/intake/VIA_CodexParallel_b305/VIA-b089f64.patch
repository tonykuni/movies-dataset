+def gather_git(fetch: bool = True) -> dict:
+    g = {"fetched": False, "fetch_attempted": fetch}
+    if fetch:
+        try:
+            r = subprocess.run(["git", "-C", str(VIA), "fetch", "origin", "--quiet"],
+                               capture_output=True, timeout=90)
