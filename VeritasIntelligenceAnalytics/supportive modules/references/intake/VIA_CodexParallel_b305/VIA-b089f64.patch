+                          "ok": r.get("ok", False), "note": r.get("err", "")})
+    else:
+        _auto_log.append({"ts": ts, "task": "boot",
+                          "why": "今日已更=跳過(marker)", "ok": True,
+                          "skipped": True})
+    queued_note = False
