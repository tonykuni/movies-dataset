+DATE_RX_Q = re.compile(r"^\d{4}-\d{2}-\d{2}$")
+CODE_RX_Q = re.compile(r"^\d{4,6}$")
+CATS_RX_Q = re.compile(r"^[a-z_]+(?:\s*,\s*[a-z_]+)*$")
