+def _poll_run_locked(run: dict):
+    """輪詢並關閉已完成的父行程 log handle；呼叫端必須持有 _lock。"""
+    rc = run["proc"].poll()
+    if rc is not None and not run.get("log_closed"):
+        try:
+            run["lf"].close()
+        except Exception:
+            pass
+        run["log_closed"] = True
+        run.setdefault("t1", time.time())
+    return rc
+
