+  if(error?.name==="AbortError")throw new ApiError("timeout","本機指揮台回應逾時");
+  if(error instanceof ApiError)throw error;
+  throw new ApiError("network",error?.message||"本機指揮台無法連線");
+ }finally{clearTimeout(timeout);}
