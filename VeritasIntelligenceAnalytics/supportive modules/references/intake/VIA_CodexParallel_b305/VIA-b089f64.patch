+            "log": logp, "lf": lf, "t0": time.time(),
+            "started": now.strftime("%H:%M:%S"),
+            "started_at": now.isoformat(timespec="seconds"),
+        }
+        return {"ok": True, "run_id": run_id,
+                "accepted_params": accepted}
