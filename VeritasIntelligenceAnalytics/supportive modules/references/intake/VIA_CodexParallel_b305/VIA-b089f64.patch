+        {"sub": "因子相對價格列覆蓋率", "pct": pct(factor_n, price_n),
+         "now": ratio_text(factor_n, price_n, "列"),
+         "next": "按[日更]鍵=boot 鏈自動重建(價格新列後)"},
+        {"sub": "族群聚合層", "pct": None,
+         "now": f"{tn.get('group_features_daily', 0):,} 列",
+         "next": "boot ⑧b 自動;月營收族群榜=按[月營收]鍵"},
+        {"sub": "月營收庫(MOPS 官方)", "pct": None,
