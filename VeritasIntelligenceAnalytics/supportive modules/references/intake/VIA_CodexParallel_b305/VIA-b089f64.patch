+        bad["X-VIA-CSRF"] = "wrong-token"
+        status, _, _ = self.request("POST", "/run", payload, bad)
+        self.assertEqual(status, 403)
+        bad = self.trusted_headers()
+        bad.pop("Sec-Fetch-Site")
+        status, _, _ = self.request("POST", "/run", payload, bad)
