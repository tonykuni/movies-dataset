+INTAKE_CAP = 50 * 1024 * 1024  # 50MB 上限(批301)
+_NAME_RX = re.compile(r"[^\w.\u4e00-\u9fff-]+")
+_WINDOWS_RESERVED = {
+    "CON", "PRN", "AUX", "NUL", "CLOCK$", "CONIN$", "CONOUT$",
+    *(f"COM{i}" for i in range(1, 10)), *(f"LPT{i}" for i in range(1, 10)),
