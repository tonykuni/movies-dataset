+    防重三閘:boot marker/任務單例/回補 (段,檔) checkpoint。"""
+    ts = datetime.now().strftime("%H:%M:%S")
+    mark = (VIA / "functional modules" / "VDF" / "output_hub" / "mega" /
+            ".last_boot_update")
+    today = datetime.now().strftime("%Y-%m-%d")
+    try:
+        done_today = mark.exists() and mark.read_text(
