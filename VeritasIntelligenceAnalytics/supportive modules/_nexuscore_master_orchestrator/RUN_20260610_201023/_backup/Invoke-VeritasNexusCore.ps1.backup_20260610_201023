        $def_PARAM_DOWNLOAD_DIR
    )) {
        def_EnsureDir -Path $dir
    }
}

function def_GetHashSafe {
    param(
        [string]$Path
    )

    if (-not (Test-Path -LiteralPath $Path)) {
        return ""
    }

    try {
        return (Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash
    } catch {
        return "HASH_FAILED"
    }
}

function def_ResolvePython {
    if ($PythonExe -and (Test-Path -LiteralPath $PythonExe)) {
        return $PythonExe
    }

    $candidates = @(
        "C:\Users\tonyk\envs\via_core_312\Scripts\python.exe",
        "C:\Users\tonyk\envs\via_core_313\Scripts\python.exe",
        "C:\Users\tonyk\envs\via_vrn_312\Scripts\python.exe",
        "C:\Users\tonyk\envs\via_vdf_312\Scripts\python.exe"
    )

    foreach ($p in $candidates) {
        if (Test-Path -LiteralPath $p) {
            return $p
        }
    }

    $cmd = Get-Command python -ErrorAction SilentlyContinue
    if ($null -ne $cmd) {
        return $cmd.Source
    }

    return ""
}

function def_GetToolType {
    param(
        [string]$Extension
    )

    $ext = $Extension.ToLowerInvariant()

    if ($ext -eq ".ps1") { return "powershell" }
    if ($ext -eq ".py") { return "python" }
    if ($ext -eq ".md") { return "markdown" }
    if ($ext -eq ".json") { return "json" }
    if ($ext -eq ".csv") { return "csv" }
    if ($ext -eq ".html" -or $ext -eq ".htm") { return "html" }
    if ($ext -eq ".txt") { return "text" }
    if ($ext -eq ".parquet") { return "parquet" }

    return "other"
}

function def_GetCategoryFromRelativePath {
    param(
        [string]$RelativePath
    )

    $parts = $RelativePath -split "[\\/]"
    if ($parts.Count -ge 2) {
        return $parts[0]
    }

    return "00_Root"
}

function def_GetLayerFromPath {
    param(
        [string]$RelativePath,
        [string]$FileName
    )

    $p = ($RelativePath + " " + $FileName).ToLowerInvariant()

    if ($p -match "read_me|readme") { return "L0_SSOT_Documentation" }
    if ($p -match "invoke-veritasnexuscore") { return "L1_Control_Entry" }
    if ($p -match "registry|ssot") { return "L2_SSOT_Registry" }
    if ($p -match "aegis|protection|guard|hardgate|risk|firewall") { return "L3_HardGate_Protection" }
    if ($p -match "env|venv|environment|installhealth") { return "L4_EnvManager" }
    if ($p -match "celeritas|acceleration|accelerator|cache|wheel|download|retry|runtime") { return "L5_Acceleration_InstallPlanner" }
    if ($p -match "report|matrix|html|dashboard|progress") { return "L6_Report_Matrix" }

    return "L9_Supportive_Tool"
}

function def_GetTargetEnv {
    param(
        [string]$Layer,
        [string]$RelativePath,
        [string]$FileName,
        [string]$ToolType
    )

    $p = ($Layer + " " + $RelativePath + " " + $FileName).ToLowerInvariant()

    if ($ToolType -eq "powershell") { return "PowerShell 7" }
    if ($ToolType -eq "markdown" -or $ToolType -eq "html" -or $ToolType -eq "json" -or $ToolType -eq "csv" -or $ToolType -eq "text") { return "document/report" }

    if ($p -match "ocr|opencv|image|vision|layout|paddle|easyocr|tesseract") { return "via_ocr_312" }
    if ($p -match "pdf|reportnova|vrn|camelot|tabula|pymupdf|pdfplumber") { return "via_vrn_312" }
    if ($p -match "twse|tpex|mops|fred|yfinance|akshare|dataforge|vdf|duckdb") { return "via_vdf_312" }
    if ($p -match "html|chart|dashboard|viz|plot") { return "via_viz_312" }

    return "via_core_312"
}

