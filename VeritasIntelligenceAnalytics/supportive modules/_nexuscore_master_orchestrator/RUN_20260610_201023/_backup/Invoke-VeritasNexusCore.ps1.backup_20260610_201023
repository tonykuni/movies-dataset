function def_Action_HardGate {
    def_WriteLine "RUN" "Action HardGate started."

    $py = def_ResolvePython
    $pythonExists = ($py -ne "" -and (Test-Path -LiteralPath $py))
    $aegisExists = Test-Path -LiteralPath $def_PARAM_AEGIS_PY
    $celeritasExists = Test-Path -LiteralPath $def_PARAM_CELERITAS_PY
    $envManagerExists = Test-Path -LiteralPath $def_PARAM_ENVMANAGER_PY

    $rows = @()
    $rows += [pscustomobject]@{ Check = "Python"; Path = $py; Status = if ($pythonExists) { "PASS" } else { "FAIL" }; Risk = if ($pythonExists) { "LOW" } else { "HIGH" } }
    $rows += [pscustomobject]@{ Check = "Aegis"; Path = $def_PARAM_AEGIS_PY; Status = if ($aegisExists) { "PASS" } else { "FAIL" }; Risk = if ($aegisExists) { "LOW" } else { "HIGH" } }
    $rows += [pscustomobject]@{ Check = "Celeritas"; Path = $def_PARAM_CELERITAS_PY; Status = if ($celeritasExists) { "PASS" } else { "FAIL" }; Risk = if ($celeritasExists) { "LOW" } else { "HIGH" } }
    $rows += [pscustomobject]@{ Check = "EnvManager"; Path = $def_PARAM_ENVMANAGER_PY; Status = if ($envManagerExists) { "PASS" } else { "FAIL" }; Risk = if ($envManagerExists) { "LOW" } else { "HIGH" } }
    $rows += [pscustomobject]@{ Check = "InstallLock"; Path = "Install action is locked by default"; Status = "PASS"; Risk = "LOW" }

    if ($pythonExists) {
        try {
            $pipVersion = & $py -m pip --version 2>&1
            $rows += [pscustomobject]@{ Check = "pip"; Path = ($pipVersion -join " "); Status = "PASS"; Risk = "LOW" }
        } catch {
            $rows += [pscustomobject]@{ Check = "pip"; Path = $_.Exception.Message; Status = "WARN"; Risk = "MEDIUM" }
        }

        try {
            $pyVersion = & $py --version 2>&1
            $rows += [pscustomobject]@{ Check = "PythonVersion"; Path = ($pyVersion -join " "); Status = "PASS"; Risk = "LOW" }
        } catch {
            $rows += [pscustomobject]@{ Check = "PythonVersion"; Path = $_.Exception.Message; Status = "WARN"; Risk = "MEDIUM" }
        }
    }

    $rows | ConvertTo-Json -Depth 10 | Set-Content -LiteralPath $def_PARAM_HARDGATE_JSON -Encoding UTF8
    def_WriteHtmlTable -Rows $rows -Title "NexusCore HardGate Report" -OutPath $def_PARAM_HARDGATE_HTML -Description "Aegis-style preflight gate. No environment modification."

    def_WriteLine "OK" "HardGate report created: $def_PARAM_HARDGATE_HTML"
    return $def_PARAM_HARDGATE_HTML
}

function def_Action_EnvPlan {
    def_WriteLine "RUN" "Action EnvPlan started."

    $rows = def_BuildRegistryRows
    $envRows = $rows |
        Group-Object TargetEnv |
        Sort-Object Name |
        ForEach-Object {
            [pscustomobject]@{
                TargetEnv = $_.Name
                ToolCount = $_.Count
                PythonTools = @($_.Group | Where-Object { $_.ToolType -eq "python" }).Count
                HardGateRequired = @($_.Group | Where-Object { $_.HardGateRequired -eq $true }).Count
                EnvRoot = "C:\Users\tonyk\envs"
                Policy = "partitioned_env_per_role; no_global_python_pollution"
            }
        }

    $plan = [ordered]@{
        PlanName = "NEXUSCORE_ENVMANAGER_PLAN"
        Generated = $def_PARAM_RUN_STAMP
        EnvRoot = "C:\Users\tonyk\envs"
        InstallLocked = $true
        Environments = @($envRows)
        RequiredOutputs = @(
            "env_health.json",
            "pip_freeze_before.txt",
            "pip_freeze_after.txt",
            "pip_check.txt",
            "install_log.txt"
        )
    }

    $plan | ConvertTo-Json -Depth 16 | Set-Content -LiteralPath $def_PARAM_ENVPLAN_JSON -Encoding UTF8
    def_WriteHtmlTable -Rows $envRows -Title "NexusCore EnvManager Plan" -OutPath $def_PARAM_ENVPLAN_HTML -Description "Environment routing plan. No venv creation in this action."

    def_WriteLine "OK" "EnvPlan created: $def_PARAM_ENVPLAN_HTML"
    return $def_PARAM_ENVPLAN_HTML
}

