    if ($Layer -eq "L1_Control_Entry") { return "Single approved entry for supportive modules" }
    if ($Layer -eq "L2_SSOT_Registry") { return "Registry or canonical tool data" }
    if ($Layer -eq "L3_HardGate_Protection") { return "Protection, network guard, environment risk gate" }
    if ($Layer -eq "L4_EnvManager") { return "Environment planning, venv isolation, dependency governance" }
    if ($Layer -eq "L5_Acceleration_InstallPlanner") { return "Acceleration, cache, wheelhouse, retry, download/install planning" }
    if ($Layer -eq "L6_Report_Matrix") { return "Report, matrix, dashboard, validation output" }

    return "Supportive utility"
}

function def_GetPriority {
    param(
        [string]$Layer
    )

    if ($Layer -eq "L0_SSOT_Documentation") { return 0 }
    if ($Layer -eq "L1_Control_Entry") { return 0 }
    if ($Layer -eq "L2_SSOT_Registry") { return 1 }
    if ($Layer -eq "L3_HardGate_Protection") { return 1 }
    if ($Layer -eq "L4_EnvManager") { return 2 }
    if ($Layer -eq "L5_Acceleration_InstallPlanner") { return 3 }
    if ($Layer -eq "L6_Report_Matrix") { return 4 }

    return 9
}

function def_GetRisk {
    param(
        [string]$Status,
        [string]$ToolType,
        [bool]$AllowDirectRun
    )

    if ($Status -eq "MISSING") { return "HIGH" }
    if ($Status -eq "EMPTY") { return "MEDIUM" }

    if ($ToolType -eq "python" -and $AllowDirectRun -eq $true) {
        return "MEDIUM"
    }

    return "LOW"
}

