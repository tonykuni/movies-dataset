function def_BuildRegistryRows {
    if (-not (Test-Path -LiteralPath $def_PARAM_BASE_DIR)) {
        throw "BaseDir not found: $def_PARAM_BASE_DIR"
    }

    $files = Get-ChildItem -LiteralPath $def_PARAM_BASE_DIR -Recurse -File |
        Where-Object {
            $_.FullName -notmatch "\\_nexuscore_action_runner\\" -and
            $_.FullName -notmatch "\\_nexuscore_action_runner_patch\\" -and
            $_.FullName -notmatch "\\_nexuscore_full_registry\\"
        } |
        Sort-Object FullName

    $rows = @()
    $index = 0

    foreach ($f in $files) {
        $index += 1

        $relative = $f.FullName.Substring($def_PARAM_BASE_DIR.Length).TrimStart("\")
        $toolType = def_GetToolType -Extension $f.Extension
        $category = def_GetCategoryFromRelativePath -RelativePath $relative
        $layer = def_GetLayerFromPath -RelativePath $relative -FileName $f.Name
        $targetEnv = def_GetTargetEnv -Layer $layer -RelativePath $relative -FileName $f.Name -ToolType $toolType
        $hardGate = def_GetHardGateRequired -Layer $layer -ToolType $toolType
        $allowDirect = def_GetAllowDirectRun -FileName $f.Name
        $role = def_GetRole -Layer $layer
        $priority = def_GetPriority -Layer $layer
        $status = if ($f.Length -gt 0) { "FOUND" } else { "EMPTY" }
        $risk = def_GetRisk -Status $status -ToolType $toolType -AllowDirectRun $allowDirect

        $rows += [pscustomobject]@{
            ToolID              = "VIA-SUP-{0:0000}" -f $index
            ToolName            = [System.IO.Path]::GetFileNameWithoutExtension($f.Name)
            FileName            = $f.Name
            Category            = $category
            Layer               = $layer
            Role                = $role
            Path                = $f.FullName
            RelativePath        = $relative
            ToolType            = $toolType
            Priority            = $priority
            TargetEnv           = $targetEnv
            HardGateRequired    = $hardGate
            AllowDirectRun      = $allowDirect
            EntryMode           = if ($allowDirect) { "DirectAllowed" } else { "NexusCoreManaged" }
            Status              = $status
            Risk                = $risk
            SizeBytes           = $f.Length
            ModifiedTime        = $f.LastWriteTime.ToString("yyyy-MM-dd HH:mm:ss")
            Sha256              = def_GetHashSafe -Path $f.FullName
            AIInstruction       = if ($allowDirect) { "Use this as the approved entry." } else { "Do not call directly. Route through NexusCore." }
            EngineerInstruction = if ($hardGate) { "Wire to HardGate and EnvManager before execution." } else { "Register and expose in matrix/report." }
        }
    }

    return @($rows)
}

function def_SaveRegistry {
    param(
        [array]$Rows
    )

    $Rows | ConvertTo-Json -Depth 12 | Set-Content -LiteralPath $def_PARAM_REGISTRY_JSON -Encoding UTF8
    $Rows | Export-Csv -LiteralPath $def_PARAM_REGISTRY_CSV -NoTypeInformation -Encoding UTF8BOM
    def_WriteHtmlTable -Rows $Rows -Title "NexusCore Full Supportive Registry" -OutPath $def_PARAM_REGISTRY_HTML -Description "All supportive modules registered under NexusCore SSOT."
}

