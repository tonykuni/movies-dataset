{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritas.local/schemas/instruction_module.schema.json",
  "title": "VIA AI Instruction Module",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_id",
    "version",
    "layer",
    "slug",
    "title",
    "status",
    "owner",
    "purpose",
    "dependencies",
    "inputs",
    "outputs",
    "owned_paths",
    "owned_symbols",
    "steps",
    "gates"
  ],
  "properties": {
    "module_id": {"type": "string", "pattern": "^VIA-AI-[0-9]{6}$"},
    "version": {"type": "string", "pattern": "^[0-9]{4}$"},
    "layer": {"enum": ["PREFLIGHT", "DATA", "CORE", "UI", "QA", "OPS"]},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "validated", "ready_for_review", "active", "deprecated", "blocked"]},
    "owner": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/io"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/io"}},
    "owned_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "owned_symbols": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "action", "on_failure"],
        "properties": {
          "step_id": {"type": "string", "pattern": "^S[0-9]{2}$"},
          "action": {"type": "string", "minLength": 1},
          "on_failure": {"enum": ["stop", "record_and_continue", "review_required"]}
        }
      }
    },
    "gates": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "io": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required"],
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string"},
        "required": {"type": "boolean"},
        "description": {"type": "string"}
      }
    }
  }
}

