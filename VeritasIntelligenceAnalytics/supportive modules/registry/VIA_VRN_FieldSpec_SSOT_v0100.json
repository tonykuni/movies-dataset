{
  "schema": "VIA_VRN_FieldSpec_SSOT_v0100",
  "batch": "批712",
  "ruled_by": "操作員 2026-09-23 本對話逐欄給定",
  "why": "研報逐列要產出的欄位規格正本。CGC_MDL181 照這本冊對帳,不自己另寫一份欄位清單(Zero-Hydra)。",
  "denominator_note": "分母=有代號的研報列(ticker 非空)。沒有代號的研報(產業/策略)在個股欄位上是 NOT_APPLICABLE,不是缺料。",
  "fields": [
    {"key": "report_date", "zh": "報告日", "spec": "report date",
     "source": "vrn_report_basic.report_date", "rule": "解析得出且不是未來日", "scope": "all"},
    {"key": "filename", "zh": "檔名", "spec": "filename",
     "source": "vrn_report_basic.report_file", "rule": "非空", "scope": "all"},
    {"key": "broker", "zh": "券商", "spec": "broker",
     "source": "vrn_report_basic.broker", "rule": "非空且出自正典冊", "scope": "all"},
    {"key": "analyst", "zh": "分析師", "spec": "analyst",
     "source": "vrn_report_analyst", "rule": "analyst_n >= 1", "scope": "all"},
    {"key": "ticker", "zh": "股票代號", "spec": "ticker",
     "source": "vrn_report_basic.ticker", "rule": "四到六碼且與檔名對得上", "scope": "all"},
    {"key": "yf_ticker", "zh": "yfinance 代號", "spec": "yfticker",
     "source": "tw_listings.yf_ticker", "rule": "四碼 + 市場別 → 2330.TW / 1240.TWO", "scope": "ticker"},
    {"key": "bloomberg_ticker", "zh": "Bloomberg 代號", "spec": "bloomberg ticker",
     "source": "CGC_MDL001.tw_ticker_variants", "rule": "四碼 + 空白 + TT(需先知道市場別)", "scope": "ticker"},
    {"key": "name", "zh": "公司名稱", "spec": "name(透過四碼 ticker 去 twse/tpex 或個股清單裡找及核對)",
     "source": "tw_listings.name", "rule": "查得到且與報告內名稱核對得上", "scope": "ticker"},
    {"key": "rating", "zh": "評等", "spec": "rating",
     "source": "vrn_report_basic.rating_raw", "rule": "落在正典評等鍵(樞紐 rating_keys)", "scope": "all"},
    {"key": "target_price_adj", "zh": "目標價(除權息調整後)",
     "spec": "target price(除權息後原本報告中前一日價格及目標價同步改為 adj)",
     "source": "vrn_report_basic.target_price × ADJ factor", "rule": "L99:tp_adj = tp x (報告日因子 / 最新日因子)", "scope": "ticker"},
    {"key": "adj_close", "zh": "最新 ADJ 收盤", "spec": "adj close(最新 yfinance)",
     "source": "tw_prices_adj.adj_close", "rule": "L99 永不拿未調整 close 頂替", "scope": "ticker"},
    {"key": "factset_consensus_median", "zh": "FactSet 共識中位", "spec": "factset consensus median(vdf)",
     "source": "analyst_estimates(source=FACTSET)", "rule": "target_median 且 source 標明 FACTSET", "scope": "ticker"},
    {"key": "yf_consensus_median", "zh": "yfinance 共識中位", "spec": "yfinance consensus median(vdf)",
     "source": "analyst_estimates(source=YAHOO).target_median", "rule": "非空且 n_analysts >= 1", "scope": "ticker"},
    {"key": "diluted_eps_n_n2", "zh": "稀釋 EPS n~n+2", "spec": "dilited eps n~n+2",
     "source": "analyst_estimates.eps0y_avg / eps1y_avg / (eps2y 缺)", "rule": "三年都要有:n, n+1, n+2", "scope": "ticker"},
    {"key": "forward_per_n_n2", "zh": "預估本益比 n~n+2", "spec": "forward per n~n+2",
     "source": "(無此欄;需 adj_close / diluted_eps 自算)", "rule": "三年都要有;分母用 ADJ 收盤", "scope": "ticker"}
  ]
}
