     "note": "VAP v0302 只在 loopback /api/health 回報、不落檔 → 本冊要求的落檔收據目前 ABSENT(GRAY 照實);VAP 下一版加落檔即接上,VCGC 不代寫"
    }
   ],
   "upstream_evidence": {
    "path": "VIA_Reports/vqg/vap_export/VAP_AllInOne_v0300.config.json",
    "zh": "VQG 給的 config(VAP 正式輸入 = VQG)"
   }
  }
 },
 "interactions": [
  {
   "from": "VCGC",
   "to": "VDF",
   "mode": "read_only",
   "what": "health · activate · macro 收據",
   "never": "改 VDF 冊 / 檔 / 號"
  },
  {
   "from": "VCGC",
   "to": "VRN2",
   "mode": "read_only",
   "what": "closeout · activate · lanes",
   "never": "改 VRN-2 套件"
  },
  {
   "from": "VCGC",
   "to": "VQG",
   "mode": "read_only",
   "what": "export_vap · vap_latest · closeout",
   "never": "改 VQG 公式"
  },
  {
   "from": "VCGC",
   "to": "VAP",
   "mode": "read_only",
   "what": "health(落檔後)· 上游 config",
   "never": "改 VAP 運行"
  },
  {
   "from": "VDF",
   "to": "VQG",
   "mode": "data_read_only",
   "what": "VQG 只讀 VDF 庫(parquet)",
   "never": "VQG 寫 VDF 夾"
  },
  {
   "from": "VQG",
   "to": "VAP",
   "mode": "manifest",
   "what": "vqg_connection_manifest(AUTHORIZED · 指紋)",
   "never": "VAP 直連 VDF"
  },
  {
   "from": "VRN2",
   "to": "VCGC",
   "mode": "number_request",
   "what": "contract/VRN2_NUMBER_REQUEST_latest.json(編號申請)",
   "never": "VRN-2 自己發號"
  }
 ],
 "why_v0100": "之前互監散在 SettleAll / HealthMatrix / MCPServer 各自硬編碼路徑與燈欄;本冊把「誰自報什麼 · 在哪 · 燈怎麼對」寫成一本,VCGC 只讀本冊;VCGC 將來強化(新站 · 新系統)只改冊不改各系統。",
 "numbering_rule": "操作員 2026-11-09:所有編號都要有版本與時間;檔名帶版本號(_vNNNN);自動隨時登錄於各子系統(各系統自己的冊 + VCGC 數冊);系統階層獨立;衝突只由操作員與 AI 合作裁定,引擎不自裁。"
}
