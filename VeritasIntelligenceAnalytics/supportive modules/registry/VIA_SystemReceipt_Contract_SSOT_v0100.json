{
 "schema": "VIA-SYSTEM-RECEIPT-CONTRACT/1.0",
 "version": "v0100",
 "ts": "2026-11-09",
 "owner": "VCGC",
 "law": "L120 / L123 四(五)系統對等獨立 · 互相只讀監控:看對方自報的燈與收據,只攤開不代修;VCGC 的 closeout_lamp 不寫成任何子系統的成功,子系統的燈也不寫成 VCGC 的驗收。",
 "rule": "操作員 2026-11-09:「VDF VRN VQG VAP 系統獨立架構可運作、獨立開發完成;但互動關係要與 VCGC 的相互監控協助先建構完美,因為 VCGC 可能會持續更強化以面對未來擴張必要」→ 互動只走本冊:每系統自報收據(路徑 · 燈欄 · 時間欄 · 版本欄);VCGC 只讀本冊列的檔;新系統 = 本冊加一節(出新版號),不改任何系統程式。",
 "lamps": [
  "GREEN",
  "YELLOW",
  "RED",
  "GRAY"
 ],
 "normalized_fields": [
  "system",
  "receipt",
  "present",
  "lamp",
  "at",
  "version",
  "age_hours",
  "stale",
  "missing_required",
  "note"
 ],
 "stale_hours": 48,
 "lamp_maps": {
  "vrn2_closeout_state": {
   "PASS": "GREEN",
   "REVIEW": "YELLOW",
   "DATA_GAP": "YELLOW",
   "BLOCKED": "YELLOW",
   "OPEN": "RED"
  },
  "vdf_overall": {
   "GREEN": "GREEN",
   "YELLOW": "YELLOW",
   "RED": "RED",
   "NODATA": "GRAY",
   "STALE": "YELLOW"
  },
  "vqg_lamp": {
   "GREEN": "GREEN",
   "YELLOW": "YELLOW",
   "RED": "RED"
  }
 },
 "systems": {
