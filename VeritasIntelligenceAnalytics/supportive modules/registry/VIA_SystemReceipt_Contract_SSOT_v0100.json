    {
     "id": "test",
     "path": "VIA_Reports/vcgc/TEST_latest.json",
     "lamp_key": "lamp",
     "at_keys": [
      "at"
     ],
     "version_keys": [
      "console"
     ],
     "required": [
      "lamp",
      "at",
      "console",
      "counts"
     ],
