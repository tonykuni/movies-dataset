{
  "schema": "VIA.VRN.TabFields.v1",
  "tabs": [
    {
      "tab": "BASIC INFO",
      "fields": [
        "fileId", "fileName", "reportType", "ticker", "market",
        "yfinanceTicker", "bloombergTicker", "tickerKind", "companyName",
        "broker", "brokerAbbr", "reportDate", "reportCode", "language",
        "period", "pages", "issuer", "rating", "ratingCat",
        "validationStatus", "validationRisk", "status"
      ]
    },
    {
      "tab": "PAGE 1",
      "cells": ["FIXED FETCH CONTENTS ON PAGE 1", "SUMMARY OF PAGE 1"],
      "fields": ["fileId", "fileName", "page", "fixed_page1", "summary_page1"]
    },
    {
      "tab": "FINANCIAL DATA",
      "fields": [
        "fileId", "fileName", "category", "statement", "item", "dataName",
        "period", "value", "unit", "confidence", "source", "status",
        "grade", "defects"
      ]
    }
  ],
  "held": [
    "parameters",
    "knowledge_assets",
    "status_lock",
    "probe_lock",
    "market_lock",
    "forward_vintage",
    "system_manager",
    "tab_store",
    "data_root"
  ],
  "open": ["page1_text", "financial_values", "html_full_columns"],
  "do_not": [
    "edit intake macro_ssot",
    "treat the short HTML table as this schema",
    "lock page1 text while it is zero"
  ]
}
