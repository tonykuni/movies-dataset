    "OPERATOR": {"zh": "操作員", "owns": ["GO_v1 權杖", "commit/push 決定", "使用者測", "正本裁決(漂移家族)", "FRED key 輪換"], "never": ["貼整段 log(貼 digest)"]},
    "ASSISTANT":{"zh": "助理", "owns": ["出新版本檔(vNNNN+1)", "沙盒實跑驗證", "讀 digest 判下一步", "誠實標缺"], "never": ["直接動 PC", "宣稱未驗證之通過", "要求整段 log"]}
  },
  "token_rule": "每回合只交換一個 digest(≤25 行):via-loop 產出。整段 log 只在 digest 標 NEED_LOG:<path> 時才貼那一檔的尾 30 行。",
