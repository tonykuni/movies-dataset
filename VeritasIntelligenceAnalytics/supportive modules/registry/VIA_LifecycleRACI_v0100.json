    {"id": "S3", "zh": "修改 MODIFY",      "R": "ASSISTANT","A": "OPERATOR", "C": ["ENGINE"],  "I": ["GITHUB"],
     "evidence": ["新版本檔 vNNNN+1(舊版原地不動)", ".viafix.bak/.predeftest.bak 在位"],
