     "gate": "six_streams overall ≠ RED;真失敗檔數 ≤ 上一輪", "next_on_pass": "S6", "next_on_fail": "S3"},
    {"id": "S6", "zh": "使用者測 USERTEST","R": "OPERATOR", "A": "OPERATOR", "C": ["ASSISTANT"],"I": ["ENGINE"],
