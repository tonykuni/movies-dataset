     "gate": "操作員回 digest:USERTEST=PASS 或列缺陷", "next_on_pass": "S7", "next_on_fail": "S5"},
    {"id": "S7", "zh": "啟用 ACTIVATE",    "R": "PC",       "A": "OPERATOR", "C": ["GITHUB"],  "I": ["ASSISTANT"],
     "evidence": ["git commit(分批)", "git push(公開 repo 自覺)", "regen-all 再生物一致"],
     "gate": "origin/main == 本機 HEAD;via-six 重跑 overall ≠ RED", "next_on_pass": "S8", "next_on_fail": "S5"},
    {"id": "S8", "zh": "完美 PERFECT",     "R": "ENGINE",   "A": "OPERATOR", "C": ["DATA","GITHUB"], "I": ["ASSISTANT"],
     "evidence": ["連續 3 輪 via-six overall GREEN", "charter 七域 GREEN", "零 CONSTANT 散落"],
     "gate": "三連綠;否則回 S5", "next_on_pass": "S8(維持)", "next_on_fail": "S5"}
  ],
  "digest_fields": ["stage", "overall", "gate_result", "blockers(≤3)", "next_action(1 行)", "need_log(path 或 none)", "head", "dirty_files", "db_present", "last_six_streams", "last_probe"]
