{
  "schema": "VIA_LifecycleRACI/1.0",
  "batch": "批344 操作員令「GitHub／PC／引擎／資料 之間的角色與責任;回測→優化→測→修→測→整併→測→除錯→使用者測→除錯→啟用→測→除錯→至完美;最低 token」",
  "actors": {
    "GITHUB":   {"zh": "遠端正史", "owns": ["origin/main 歷史", "CI 綠燈", "公開可見性"], "never": ["本機 DB", "憑證", "未 commit 工作區"]},
    "PC":       {"zh": "本機執行", "owns": ["工作樹", "DuckDB(output_hub/mega)", "venvs(via_vrn4 等)", "樞紐 127.0.0.1:8765", "GO 權杖執行"], "never": ["改寫 GitHub 歷史", "OneDrive 讀寫"]},
    "ENGINE":   {"zh": "引擎模組", "owns": ["CGC_MDL*/ENG* 版本檔", "--selftest [計] 行", "再生物 VIA_UI_*", "只增不減版本"], "never": ["覆寫舊版", "無 GO 寫母樹", "假綠燈"]},
