     "gate": "漂移家族數不增;新收容全 INTEGRATED", "next_on_pass": "S5", "next_on_fail": "S4"},
    {"id": "S5", "zh": "除錯 DEBUG",       "R": "ENGINE",   "A": "ASSISTANT","C": ["PC"],      "I": ["OPERATOR"],
