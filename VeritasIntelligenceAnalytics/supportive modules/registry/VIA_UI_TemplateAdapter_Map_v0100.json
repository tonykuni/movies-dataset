{
 "schema": "VIA.UI.TemplateAdapter.Map.v1",
 "version": "v0100",
 "append_only": true,
 "policy": "模板轉接器對照冊(R26):外部設計檔的鍵名 → VIA_UI_TemplateSSOT 的鍵。只增不減;同義字一律正規化後比(小寫、分隔符統一為 -、去掉 color/colors/sys/ref/semantic/token/theme 前綴)。一個來源鍵可同時餵多個 SSOT 鍵(例 background → palette.bg 與 dashboard.color_bg)。值型別不合(把字型塞進顏色)不收。",
 "strip_prefixes": ["color", "colors", "clr", "sys", "ref", "semantic", "token", "tokens", "theme", "light", "base", "global", "via", "md"],
 "dark_markers": ["dark", "night", "inverse"],
 "keys": [
  {"key": "palette.bg", "kind": "color", "syn": ["background", "bg", "canvas", "page", "page-bg", "background-default", "surface-page", "body-bg"]},
  {"key": "palette.surface", "kind": "color", "syn": ["surface", "card", "card-bg", "surface-default", "surface-1", "paper", "elevated"]},
  {"key": "palette.border", "kind": "color", "syn": ["border", "outline", "stroke", "border-default", "divider"]},
  {"key": "palette.line", "kind": "color", "syn": ["line", "separator", "border-subtle", "hairline", "border-muted"]},
  {"key": "palette.text", "kind": "color", "syn": ["text", "foreground", "fg", "on-surface", "on-background", "body", "text-primary", "ink", "text-default"]},
  {"key": "palette.mut", "kind": "color", "syn": ["muted", "text-muted", "text-disabled", "placeholder", "text-tertiary", "muted-foreground"]},
  {"key": "palette.sub", "kind": "color", "syn": ["secondary-text", "text-secondary", "subtle", "text-subtle", "caption"]},
  {"key": "palette.accent", "kind": "color", "syn": ["accent", "primary", "brand", "action", "primary-default", "brand-primary"]},
  {"key": "palette.accent_text", "kind": "color", "syn": ["on-primary", "on-accent", "primary-foreground", "accent-foreground", "on-brand"]},
  {"key": "palette.warn_bg", "kind": "color", "syn": ["warning-bg", "warning-surface", "warning-subtle", "alert-bg", "caution-bg", "warning-background"]},
  {"key": "palette.warn_border", "kind": "color", "syn": ["warning-border", "alert-border", "caution-border"]},
  {"key": "status.OK", "kind": "color", "syn": ["success", "ok", "positive", "pass", "status-success", "status-ok", "green", "good"]},
  {"key": "status.FAIL", "kind": "color", "syn": ["danger", "error", "fail", "negative", "critical", "destructive", "status-error", "status-danger", "red", "bad"]},
  {"key": "status.SKIP", "kind": "color", "syn": ["warning", "warn", "caution", "attention", "status-warning", "amber", "yellow"]},
  {"key": "status.UNTESTED", "kind": "color", "syn": ["neutral", "untested", "inactive", "disabled", "status-neutral", "gray", "grey", "unknown"]},
  {"key": "font.family", "kind": "font", "syn": ["font-family", "font-sans", "family", "typeface", "body-font", "font-body", "font-family-base", "font"]},
  {"key": "dashboard.font_family", "kind": "font", "syn": ["font-family", "font-sans", "family", "typeface", "body-font", "font-body", "font-family-base", "font"]},
  {"key": "font.line_height", "kind": "number", "syn": ["line-height", "leading", "line-height-base", "lh"]},
  {"key": "radius.card", "kind": "length", "syn": ["radius", "radius-md", "radius-card", "rounded", "border-radius", "radius-lg", "corner"]},
  {"key": "radius.tab", "kind": "length", "syn": ["radius-sm", "radius-tab", "rounded-sm", "radius-button"]},
  {"key": "space.gap", "kind": "length", "syn": ["gap", "space-sm", "spacing-2", "space-2", "spacing-sm", "gutter"]},
  {"key": "layout.max_width", "kind": "length", "syn": ["max-width", "container", "content-width", "container-max", "page-width"]},
  {"key": "layout.mobile_breakpoint_px", "kind": "length", "syn": ["breakpoint-sm", "mobile", "screen-sm", "bp-sm"]},
  {"key": "layout.tap_min_px", "kind": "length", "syn": ["tap-target", "touch-target", "hit-area", "min-target", "tap-min"]},
  {"key": "dashboard.font_pc_px", "kind": "length", "syn": ["font-size", "font-size-base", "text-base", "body-size", "font-size-md", "fs-base", "font-size-body"]},
  {"key": "dashboard.font_mobile_px", "kind": "length", "syn": ["font-size-sm", "text-sm", "font-size-mobile", "fs-sm", "font-size-small"]},
  {"key": "dashboard.panel_w_px", "kind": "length", "syn": ["sidebar-width", "panel-width", "nav-width", "drawer-width", "sidebar", "aside-width"]},
  {"key": "dashboard.header_h_px", "kind": "length", "syn": ["header-height", "topbar-height", "toolbar-height", "appbar-height", "navbar-height", "header"]},
  {"key": "dashboard.breakpoint_px", "kind": "length", "syn": ["breakpoint-md", "breakpoint", "tablet", "screen-md", "bp-md"]},
  {"key": "dashboard.chart_min_h_px", "kind": "length", "syn": ["chart-min-height", "chart-height-min", "chart-min-h"]},
  {"key": "dashboard.chart_max_h_px", "kind": "length", "syn": ["chart-max-height", "chart-height-max", "chart-height", "chart-max-h"]},
  {"key": "dashboard.color_bg", "kind": "color", "syn": ["background", "bg", "canvas", "page", "page-bg", "background-default", "surface-page", "body-bg"]},
  {"key": "dashboard.color_panel_bg", "kind": "color", "syn": ["sidebar-bg", "panel-bg", "surface-2", "surface-muted", "secondary-bg", "background-subtle", "surface-subtle"]},
  {"key": "dashboard.color_border", "kind": "color", "syn": ["border", "outline", "stroke", "border-default", "divider"]},
  {"key": "dashboard.color_grid", "kind": "color", "syn": ["grid", "chart-grid", "gridline", "grid-line", "chart-gridline"]},
  {"key": "dashboard.alert_bg", "kind": "color", "syn": ["warning-bg", "warning-surface", "warning-subtle", "alert-bg", "caution-bg", "warning-background"]},
  {"key": "dashboard.input_border", "kind": "color", "syn": ["input-border", "field-border", "control-border", "form-border", "input-stroke"]},
  {"key": "chart.axis_px", "kind": "length", "syn": ["chart-axis-font", "axis-label-size", "axis-font-size", "chart-label-size"]}
 ],
 "series": {"key": "chart.series", "kind": "color", "rx": "^(?:chart|series|data|categorical|viz|dataviz|palette-chart)-?(\\d{1,2})$"}
}
