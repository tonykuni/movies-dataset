  "generated": "2026-11-26",
  "description": "全部主要財報科目與計算公式（資產負債表、損益表、現金流量表、比率、每股指標）",
  "balance_sheet": {
    "total_assets": "current_assets + non_current_assets",
    "current_assets": "cash + short_term_investment + accounts_receivable + inventory + other_current_assets",
    "non_current_assets": "ppe + intangible_assets + long_term_investment + other_non_current_assets",
    "total_liabilities": "current_liabilities + non_current_liabilities",
    "total_equity": "share_capital + capital_surplus + retained_earnings + other_equity",
    "balance_check": "total_assets == total_liabilities + total_equity"
  },
  "income_statement": {
    "gross_profit": "revenue - cost_of_sales",
    "operating_income": "gross_profit - operating_expenses",
    "income_before_tax": "operating_income + non_operating_income - non_operating_expense",
    "net_income": "income_before_tax - income_tax",
    "ebit": "operating_income",
    "ebitda": "ebit + depreciation + amortization"
  },
  "cash_flow": {
    "net_change_in_cash": "operating_cf + investing_cf + financing_cf",
    "operating_cf": "net_income + non_cash_items + changes_in_working_capital",
    "free_cash_flow": "operating_cf - capex"
  },
  "ratios": {
    "current_ratio": "current_assets / current_liabilities",
    "quick_ratio": "(current_assets - inventory) / current_liabilities",
    "debt_ratio": "total_liabilities / total_assets",
    "gross_margin": "gross_profit / revenue",
    "operating_margin": "operating_income / revenue",
    "net_margin": "net_income / revenue",
    "roe": "net_income / equity",
    "roa": "net_income / total_assets",
    "inventory_turnover": "cost_of_sales / average_inventory",
    "receivable_turnover": "revenue / average_receivable",
    "asset_turnover": "revenue / average_assets",
    "inventory_days": "365 / inventory_turnover",
    "receivable_days": "365 / receivable_turnover"
  },
  "per_share": {
    "eps": "net_income / shares_outstanding",
    "dps": "cash_dividend_total / shares_outstanding",
    "bvps": "equity / shares_outstanding",
    "dividend_yield": "dps / adj_close",
    "per": "adj_close / eps",
    "pbr": "adj_close / bvps"
  },
  "dupont": {
