    "regex": {
      "taiwan_phone": {
        "ssot_key": "TAIWAN_PHONE",
        "pattern": "(?<!\\d)(?:(?:\\+?886)[\\s().-]*0?|0)(?:9(?:[\\s.-]*\\d){8}|[2-8](?:[\\s().-]*\\d){7,8})(?!\\d)",
        "flags": 2,
        "description": "台灣行動電話與市內電話，允許國碼、空白、括號及連字號",
        "examples": [
          "0912345678",
          "+886 912 345 678",
          "02-2345-6789",
          "+886-2-2345-6789"
        ]
      },
      "hong_kong_phone": {
        "ssot_key": "HONG_KONG_PHONE",
        "pattern": "(?<!\\d)(?:(?:\\+?852)[\\s().-]*)?[2356789](?:[\\s.-]*\\d){7}(?!\\d)",
        "flags": 0,
        "description": "香港八位電話，允許 +852、空白及連字號",
        "examples": [
          "2123 4567",
          "+852 9123 4567"
        ]
      },
      "email": {
        "ssot_key": "EMAIL",
        "pattern": "(?<![A-Z0-9._%+\\-])[A-Z0-9._%+\\-]+@[A-Z0-9.-]+\\.[A-Z]{2,63}(?![A-Z0-9._%+\\-])",
        "flags": 2,
        "description": "一般電子郵件地址",
        "examples": [
          "john.smith@morganstanley.com",
          "analyst@kgi.com.tw"
        ]
      },
      "local_part": {
        "ssot_key": "EMAIL_LOCAL_PART",
        "pattern": "^[A-Z0-9]+(?:[._+\\-][A-Z0-9]+)*$",
        "flags": 2,
        "description": "Email @ 左側 local part",
        "examples": [
          "john.smith",
          "p.oconnor",
          "analyst01"
        ]
      },
      "domain": {
        "ssot_key": "DOMAIN",
        "pattern": "^(?:[A-Z0-9](?:[A-Z0-9\\-]{0,61}[A-Z0-9])?\\.)+[A-Z]{2,63}$",
        "flags": 2,
        "description": "DNS 網域名稱",
        "examples": [
          "kgi.com.tw",
          "research.ubs.com"
        ]
      },
      "chinese_name": {
        "ssot_key": "CHINESE_NAME",
        "pattern": "^[\\u3400-\\u9fff]{2,6}$|^[\\u3400-\\u9fff]{1,3}[·・\\s][\\u3400-\\u9fff]{1,4}$",
        "flags": 0,
        "description": "完整中文字姓名；只在 Email 或電話鄰近區域使用",
        "examples": [
          "王小明",
          "歐陽明",
          "阿里・木拉提"
        ]
      },
      "english_name": {
        "ssot_key": "ENGLISH_NAME",
        "pattern": "^[A-Z](?:[A-Z]|[A-Z'’\\-]*[A-Z])?\\.?(?:\\s+[A-Z](?:[A-Z]|[A-Z'’\\-]*[A-Z])?\\.?){1,4}$",
        "flags": 2,
        "description": "二至五段英文姓名，支援縮寫、撇號與連字號",
        "examples": [
          "John Smith",
          "Patrick O'Connor",
          "J. P. Morgan"
        ]
      },
      "institution_label": {
        "ssot_key": "INSTITUTION_LABEL",
        "pattern": "(?:[\\u3400-\\u9fff]{2,16}(?:證券|投顧|銀行|資本)|[A-Z][A-Z&.'’\\- ]{1,50}(?:Securities|Capital Markets|Research|Bank))",
        "flags": 2,
        "description": "Email 鄰近區域的候選機構名稱；僅供 overlay 學習",
        "examples": [
          "摩根士丹利證券",
          "Morgan Stanley Research"
        ]
      }
    },
