{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "def_ReadTextSafe Input",
  "type": "object",
  "required": [
    "engine_id",
    "mode",
    "input",
    "policy"
  ],
  "properties": {
    "engine_id": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "dry_run",
        "sandbox",
        "actual"
      ]
    },
    "input": {
      "type": "object"
    },
    "options": {
      "type": "object"
    },
    "policy": {
      "type": "object"
    }
  }
}
