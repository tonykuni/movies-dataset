[
  {
    "rule_id": "DATE_YYYYMMDD",
    "target": "report_date",
    "regex": "(20\\d{2})[-_./年]?(0[1-9]|1[0-2])[-_./月]?([0-2]\\d|3[01])日?",
    "definition": "西元年月日。"
  },
  {
    "rule_id": "DATE_ROC_YYYMMDD",
    "target": "report_date",
    "regex": "(1[0-2]\\d)[-_./年]?(0[1-9]|1[0-2])[-_./月]?([0-2]\\d|3[01])日?",
    "definition": "民國年月日，解析時 +1911。"
  },
  {
    "rule_id": "PERIOD_QUARTER_EN",
    "target": "period_quarter",
    "regex": "\\b(20\\d{2})\\s*Q([1-4])\\b|\\bQ([1-4])\\s*(20\\d{2})\\b",
    "definition": "2025Q1 / Q1 2025。"
  },
  {
    "rule_id": "PERIOD_QUARTER_ZH",
    "target": "period_quarter",
    "regex": "(20\\d{2})\\s*年第?\\s*([一二三四1234])\\s*季",
    "definition": "中文季度。"
  },
  {
    "rule_id": "PERIOD_MONTH",
    "target": "period_month",
    "regex": "(20\\d{2})[-_/年](0?[1-9]|1[0-2])月?",
    "definition": "年月。"
  },
  {
    "rule_id": "PERIOD_YEAR",
    "target": "period_year",
    "regex": "\\b(20\\d{2})\\b",
    "definition": "年份。"
  }
]