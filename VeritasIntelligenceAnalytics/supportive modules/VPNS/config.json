{
  "encodings": [
    "utf-8-sig",
    "utf-8",
    "big5",
    "cp950",
    "gbk",
    "gb2312",
    "gb18030",
    "big5-hkscs",
    "shift_jis",
    "cp932",
    "euc-jp",
    "iso-2022-jp",
    "euc-kr",
    "cp949",
    "utf-16",
    "utf-16-le",
    "utf-16-be",
    "hz",
    "cp1252",
    "iso-8859-1",
    "latin-1"
  ],
  "force_encoding": null,
  "min_cases_for_mining": 2,
  "dfg_freq_filter": 1,
  "anomaly_contamination": 0.25,
  "auto_update_ssot_regex": true,
  "system_code_format": "{DEPT}-{PROC}-{YYYYMMDD}-{SEQ:04d}",
  "folders": [
    "",
    "mm",
    "process",
    "control",
    "ai_extracted",
    "archive"
  ],
  "base_path": ".",
  "paths": {
    "input": "input",
    "mm": "input/mm",
    "control": "input/control",
    "temp": "temp",
    "lake": "lake",
    "output": "output",
    "archive": "archive",
    "normalized": "_vpns_system/normalized",
    "workflows": "_vpns_system/workflows",
    "event_logs": "_vpns_system/event_logs",
    "registry": "_vpns_system/registry",
    "reports": "_vpns_system/reports",
    "runtime": "_vpns_system/runtime"
  },
  "input_formats": [
    "csv",
    "xlsx",
    "json",
    "md",
    "txt",
    "pdf",
    "docx",
    "png",
    "jpg",
    "html"
  ],
  "normalized_layers": [
    "raw_source",
    "extraction_block",
    "entity_layer",
    "workflow_candidate",
    "event_log",
    "process_model",
    "ssot",
    "regex_registry",
    "html_report"
  ],
  "output_formats": {
    "event_log": [
      "csv",
      "json",
      "parquet",
      "xes"
    ],
    "workflow": [
      "bpmn",
      "dfg_json"
    ],
    "ssot": "json",
    "regex_registry": "json",
    "report": "html"
  }
}
