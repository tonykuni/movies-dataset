{
 "$schema": "VIA-VAP-CHARTLIB/1.0",
 "meta": {
  "code": "VIA-SSOT-VAPLIB",
  "seal": "觀 · VIA-SEAL-GUAN",
  "name": "VeritasAutoPlot 圖庫定義 SSOT",
  "version": "1.1.4",
  "updated": "2026-08-12",
  "specRef": "ssot/vap_spec.json",
  "policy": "只增不減 · 每型唯一(同主題去重)· 新增圖型須配 VAP-CH 代碼"
 },
 "groups": [
  {
   "id": "single",
   "zh": "單軸",
   "en": "Single-Axis",
   "charts": [
    {
     "code": "VAP-CH-01",
     "id": "line",
     "zh": "折線圖",
     "en": "Line",
     "axes": 1,
     "dataShape": "series[]",
     "fields": [
      "date",
      "value"
     ],
     "use": "水準/指數趨勢"
    },
    {
     "code": "VAP-CH-02",
     "id": "area",
     "zh": "面積折線",
     "en": "Area",
     "axes": 1,
     "dataShape": "series",
     "fields": [
      "date",
      "value"
     ],
     "use": "單一序列強調量體",
     "override": {
      "fill.areaUnderLine": 0.75
     }
    },
    {
     "code": "VAP-CH-03",
     "id": "bar",
     "zh": "直條圖",
     "en": "Bar",
     "axes": 1,
     "dataShape": "categorical",
     "fields": [
      "label",
      "value"
     ],
