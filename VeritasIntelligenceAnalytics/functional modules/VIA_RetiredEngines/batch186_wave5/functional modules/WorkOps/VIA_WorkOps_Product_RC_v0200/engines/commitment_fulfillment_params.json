{
  "version": "v0100",
  "engine_id": "ENG-043",
  "purpose": "Extract/confirm/track commitments with immutable IDs and evidence links.",
  "candidate_sources": [
    "followup_state.json",
    "commitment_candidates_input.jsonl"
  ],
  "status_rules": {
    "due_soon_hours": 24,
    "overdue_grace_hours": 0
  },
  "required_fields": [
    "project_id_or_case",
    "owner",
    "due_at",
    "commitment_text",
    "evidence"
  ],
  "governance": {
    "derived_candidates_are_not_facts": true,
    "human_confirmation_required_to_register": true,
    "human_confirmation_required_to_revise_due": true,
    "human_confirmation_required_to_fulfill_without_direct_evidence": true,
    "append_only_registry": true
  }
}