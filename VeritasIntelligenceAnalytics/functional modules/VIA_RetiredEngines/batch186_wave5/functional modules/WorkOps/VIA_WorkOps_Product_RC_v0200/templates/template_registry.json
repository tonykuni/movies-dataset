{
  "version": "v0100",
  "registry_id": "TPL-REGISTRY",
  "supported_languages": [
    {
      "code": "zh-TW",
      "label": "繁體中文"
    },
    {
      "code": "zh-CN",
      "label": "简体中文"
    },
    {
      "code": "en",
      "label": "English"
    }
  ],
  "default_language": "zh-TW",
  "default_template": "progress_followup",
  "coexistence_policy": {
    "multiple_templates_allowed": true,
    "multiple_languages_per_template": true,
    "project_default_template_allowed": true,
    "run_override_allowed": true,
    "template_id_immutable": true,
    "display_name_changeable": true
  },
  "templates": [
    {
      "template_id": "TPL-PROGRESS",
      "key": "progress_followup",
      "display_name": {
        "zh-TW": "進度追蹤",
        "zh-CN": "进度跟踪",
        "en": "Progress Follow-up"
      },
      "file": "progress_followup.json",
      "use_when": [
        "IN_PROGRESS",
        "WAITING",
        "UNKNOWN"
      ]
    },
    {
      "template_id": "TPL-BLOCKED",
      "key": "blocked_recovery",
      "display_name": {
        "zh-TW": "卡關與復原方案",
        "zh-CN": "受阻与恢复方案",
        "en": "Blocked & Recovery Plan"
      },
      "file": "blocked_recovery.json",
      "use_when": [
        "BLOCKED",
        "NEED_HELP",
        "AT_RISK",
        "OVERDUE"
      ]
    },
    {
      "template_id": "TPL-APPROVAL",
      "key": "approval_request",
      "display_name": {
        "zh-TW": "核准／決策請求",
        "zh-CN": "批准／决策请求",
        "en": "Approval / Decision Request"
      },
      "file": "approval_request.json",
      "use_when": [
        "APPROVAL_PENDING",
        "DECISION_PENDING"
      ]
    },
    {
      "template_id": "TPL-CLOSURE",
      "key": "closure_confirmation",
      "display_name": {
        "zh-TW": "結案確認",
        "zh-CN": "结案确认",
        "en": "Closure Confirmation"
      },
      "file": "closure_confirmation.json",
      "use_when": [
        "DONE_CANDIDATE",
        "READY_TO_CLOSE"
      ]
    }
  ]
}