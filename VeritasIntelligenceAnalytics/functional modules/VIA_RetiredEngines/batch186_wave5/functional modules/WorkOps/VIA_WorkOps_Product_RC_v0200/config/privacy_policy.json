{
  "version": "v0200",
  "data_location": "LOCAL_MACHINE",
  "cloud_processing_by_workops": false,
  "outlook_source_mutation_default": false,
  "auto_send": false,
  "token_cache_backup": false,
  "attachment_content_storage_default": false,
  "retention": {
    "raw_email_events_days": 365,
    "audit_events_days": 730,
    "closed_project_days": 0,
    "backup_keep_count": 14
  },
  "backup_exclusions": [
    "runtime/msal_token_cache.json",
    "runtime/*.lock",
    "logs/*.tmp"
  ],
  "user_controls": [
    "export",
    "backup",
    "restore_to_staging",
    "logical_archive"
  ],
  "notes": {
    "zh-TW": "預設只在本機保存工作資料；Outlook 權限由 IT/Entra 設定決定。",
    "zh-CN": "默认仅在本机保存工作数据；Outlook 权限由 IT/Entra 设置决定。",
    "en": "Work data is local by default; Outlook permissions remain controlled by IT/Entra."
  }
}