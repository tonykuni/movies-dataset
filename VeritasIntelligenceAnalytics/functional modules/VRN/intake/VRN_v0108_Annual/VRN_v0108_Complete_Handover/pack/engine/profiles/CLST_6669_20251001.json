  "readable_digest_zh": {
    "評價與修正": {
      "source_text_sha256": "ffe0e3284a36ef91a1c7f10fa1ef5ea1f40425cddb95d8ef9871073aa0ca3892",
      "text_zh": "報告把 2025／2026／2027 年預估每股盈餘分別調高 6%／14%／18%。目標價由 3,600 元提高至 4,200 元，採用 2026 年預估盈餘的 16 倍本益比；原文維持「OUTPERFORM」評等。",
      "review_status": "HUMAN_SOURCE_BOUND_REVIEW"
    },
    "成長驅動": {
      "source_text_sha256": "83d0e3936caa2b58308a6ac6a5deb86225a0673ad88c76d688a8e4e8cfa6e613",
      "text_zh": "報告認為一般伺服器與 Oracle AI 伺服器需求，可緩和 AWS 晶片從 Trainium2 換代至 Trainium3 的影響。預期 Oracle 營收貢獻從 2025 年第 4 季開始，2026 年達約 5%，並可能高於預期。",
      "review_status": "HUMAN_SOURCE_BOUND_REVIEW"
    },
    "短期展望": {
      "source_text_sha256": "c3932abb25539e918e9dc0f67046b056405b30922814ed24f5a456396d94deda",
      "text_zh": "報告預估 2025 年 9 月營收為新臺幣 850 億元，較前月減少 11%、較去年同期增加 146%；第 3 季營收預估為 2,660 億元，比市場共識高 17%。",
      "review_status": "HUMAN_SOURCE_BOUND_REVIEW"
    },
    "投資風險": {
      "source_text_sha256": "6afcc8c7906cf4d9c3ee606a04115ca6775d2426478c9d2a2fd99c7844b5af95",
      "text_zh": "報告列出四項風險：雲端客戶減少資本支出、資料中心硬體競爭加劇、新客戶及 AI 業務成長較慢，以及關鍵零組件短缺。",
      "review_status": "HUMAN_SOURCE_BOUND_REVIEW"
    }
  }
}