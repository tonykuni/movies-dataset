{
  "ssot": "VIA_VRN_ValuationMethod_SSOT",
  "version": "v0100",
  "owner_engine": "VRN_ENG395_ValuationMethodLexicon",
  "requirement": "VRN-REQ011",
  "created": "2026-10-01",
  "purpose": "財務評價方法(valuation_method)單一事實來源:標準代碼 VAL_* · 英文全稱 / 縮寫 · 台灣繁體 · 香港 · 大陸簡體慣用語分區 · 預估 / 歷史等變體 · 需語境判斷的歧義詞。舊詞庫(SYNONYM_LIBRARY_v4 scope valuation_method · VRN_ENG062 VALUATION_METHODS)全數對到本冊代碼(crosswalk),不另寫第二份。",
  "code_rule": "VAL_<英數底線>;只增,舊碼不改不刪;操作員稿的 VAL_M&A 因含「&」不能當代碼 → 正式碼 VAL_MA,id_alias 保留 VAL_M&A",
  "match_rule": {
    "normalize": "NFKC(全形轉半形:Ｐ／Ｅ → P/E)· 斜線兩側空白去掉(P / E → P/E)· 連續空白壓一格",
    "latin": "前後不得緊貼英數字(EV/EBIT 不會吃進 EV/EBITDA · PE 不會吃進 PEG / operating);全稱不分大小寫",
    "case_sensitive": "≤4 字母的縮寫(PE · PER · PB · PS · NAV · DCF …)只認大寫,避免 per share / pe 之類英文常字誤判",
    "cjk": "最長詞優先(本益比河流圖 → VAL_BAND,不是 VAL_PE)",
    "region": "命中詞只在某一區的清單 → 標該區;多區共用 → 列全部區"
  },
  "regions": {
    "en": "英文",
    "zh_tw": "台灣繁體",
    "zh_hk": "香港繁體(港式用語與台灣不同:市盈率 · 市賬率 · 市銷率)",
    "zh_cn": "大陸簡體"
  },
  "region_note": "操作員稿把 ZH-TW / HK 併一欄;實務上香港用「市盈率 / 市賬率」而不用「本益比 / 股價淨值比」,故本冊另開 zh_hk 欄,台灣欄只放台灣用語。",
  "groups": {
    "EQUITY_MULTIPLE": "股權乘數估值(Equity Multiples / Relative)",
