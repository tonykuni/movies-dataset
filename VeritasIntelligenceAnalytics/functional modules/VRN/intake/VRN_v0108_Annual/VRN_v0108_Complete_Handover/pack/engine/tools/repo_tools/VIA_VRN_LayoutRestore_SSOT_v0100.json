  "figure": {
    "min_ticks": 4,
    "tick_rel_tol": 0.02,
    "x_label_rx": "^(?:(?:19|20)\\d{2}[AEFP]?|\\d[QH]\\d{2}[AEF]?|[A-Z][a-z]{2}-\\d{2})$"
  },
  "validation": {
    "pct_tol_extra": 0.01,
    "growth_tol_pp": 0.6,
    "constant_cv_max": 0.03,
    "identity_share": 0.8,
    "verdicts": {
      "GREEN": "形狀一致 · 欄型一致 · 驗算式成立或無矛盾 · 無未歸位",
      "YELLOW": "形狀一致但有未歸位分組 / 並排左右未定 / 驗算缺 / 個別列違反已確立的驗算式",
      "RED": "形狀不一致(列值數不同)或欄型混雜"
    }
