{
  "ssot": "VIA_VRN_LayoutRestore_SSOT",
  "version": "v0100",
  "owner_engine": "VRN_ENG394_LayoutRestore",
  "requirement": "VRN-REQ010",
  "created": "2026-10-01",
  "purpose": "版面還原規則冊:資訊區(上/左/右/下)與本文區拆開 · 扁平文字裡的表格還原(表號/說明 · 表頭 · 表身 · 資料來源)· 圖表辨識 · 小字頁尾/免責/附錄排除 · 表格正確性驗算。引擎照冊讀,不另寫第二份。",
  "zones": {
    "INFO": "資訊區:頁緣帶(上/下)· 窄側欄(左/右)· 鍵值或數字密集區 · 一切表格(含本文裡抽出的扁平表) · 非頁底的小字(作者 / 聯絡 / 註)· 目錄",
    "BODY": "本文區:一句一列,帶據點(頁 · 區路徑 · 行 · bbox · 字級 · 粗體 · 次類別)",
    "FIGURE": "圖:影像區 · 文字層裡的座標軸刻度 / 圖例(數值無法由文字還原,誠實標示)",
    "EXCLUDED": "排除區:小字頁尾 · 免責聲明 · 報告後方附錄及其標題(不擷取,只記位置與理由)"
  },
  "categories": {
    "text": "文",
    "table": "表",
    "figure": "圖"
  },
  "subcategories": {
    "H1": "大標(字級 ≥ 本文 × 1.5)",
    "H2": "中標(≥ × 1.25)",
    "H3": "小標(≥ × 1.1,或與本文同級但粗體的短行)",
    "BODY": "本文",
    "SMALL": "小字(< 本文 × 0.85)",
    "FOOTER": "小字且無關的頁尾 / 免責(排除)"
  },
  "font": {
    "h1": 1.5,
    "h2": 1.25,
    "h3": 1.1,
    "small": 0.85,
    "bold_flag": 16,
    "heading_max_chars": 60
  },
  "layout": {
    "order": "vertical_first",
    "min_gap_pt": 8.0,
    "top_band": 0.12,
    "bottom_band": 0.9,
    "side_max_width": 0.36,
    "side_edge": 0.4,
    "kv_dense": 0.5,
    "min_prose_chars": 300,
    "kv_min_lines": 3,
    "band_min_width": 0.6
  },
  "tables": {
    "min_rows": 3,
    "min_values": 2,
    "max_label_chars": 60,
    "row_mode_share": 0.6,
    "cell_space_rule": "CJK 字間空白全去 · 英數詞間空白壓成一格 · 前後 TRIM",
    "merged_cells": "表頭列 None → 向右延(同一合併格)· 首欄 None → 向下延(分組列)· 其餘 None → 空字串並記號",
    "stack_split": "整列全空 · 數字列之後再出現全文字列(新表頭)→ 上下拆",
    "side_split": "整欄全空 → 左右拆;表頭詞鏈重複 n 次 → 並排 n 張(扁平文字)",
    "caption_max_chars": 120
  },
