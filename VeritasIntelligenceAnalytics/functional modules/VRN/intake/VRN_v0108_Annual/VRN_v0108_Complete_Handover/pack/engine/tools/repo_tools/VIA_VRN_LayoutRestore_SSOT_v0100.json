  "caption_rx": "^(?:(?P<no>(?:Exhibit|Figure|Fig\\.|Table|Chart|圖表|圖|表)\\s*[0-9A-Z][0-9A-Z\\-\\.]*)\\s*[:：]?\\s*)?(?P<title>.*)$",
  "figure_caption_rx": "(?:Exhibit|Figure|Fig\\.|Chart|圖表|圖)\\s*[0-9A-Z][0-9A-Z\\-\\.]*\\s*[:：]",
  "source_rx": "(?:Source|Sources|資料來源|來源)\\s*[:：]",
