{
  "schema_version": "1.0.0",
  "default_type": "UNCLASSIFIED_RESEARCH",
  "types": {
    "DAILY_MORNING_BRIEF": {"zh": "晨報／晨訊／每日盤前簡報", "en": "Daily Morning Brief", "scope": "CONTAINER", "priority": 100, "patterns": ["晨報", "晨訊", "盤前(?:簡報|重點|摘要)", "MORNING\\s+(?:BRIEF|NOTE|CALL)", "DAILY\\s+(?:BRIEF|RESEARCH|NOTE)"]},
    "DAILY_MARKET_REPORT": {"zh": "市場日報", "en": "Daily Market Report", "scope": "MARKET", "priority": 94, "patterns": ["市場日報", "投資日報", "DAILY\\s+MARKET\\s+REPORT"]},
    "MARKET_WRAP": {"zh": "盤後講評／市場收盤總結", "en": "Market Wrap / Closing Recap", "scope": "MARKET", "priority": 96, "patterns": ["盤後(?:講評|解析|總結)", "收盤(?:講評|回顧)", "MARKET\\s+WRAP", "CLOSING\\s+RECAP"]},
    "RESEARCH_MEMO": {"zh": "研究備忘錄／投資備忘錄", "en": "Research Memo / Investment Memo", "scope": "COMPANY_OR_TOPIC", "priority": 90, "patterns": ["研究備忘錄", "投資備忘錄", "(?:CALL|RESEARCH|COMPANY|INVESTMENT)\\s+MEMO", "MEMORANDUM"]},
    "EQUITY_FLASH": {"zh": "個股即時快訊／短評", "en": "Equity Flash / Company Flash", "scope": "COMPANY", "priority": 92, "patterns": ["個股快訊", "即時短評", "閃電點評", "EQUITY\\s+FLASH", "COMPANY\\s+FLASH", "FLASH\\s+NOTE"]},
    "COMPANY_UPDATE": {"zh": "個股動態更新／追蹤報告", "en": "Company Update", "scope": "COMPANY", "priority": 45, "patterns": ["個股(?:更新|追蹤)", "公司(?:更新|追蹤)", "COMPANY\\s+UPDATE", "EQUITY\\s+UPDATE"]},
    "INITIATION_OF_COVERAGE": {"zh": "初次評等／首次覆蓋報告", "en": "Initiation of Coverage", "scope": "COMPANY", "priority": 99, "patterns": ["初次評等", "首次覆蓋", "納入研究", "INITIAT(?:E|ING|ION)\\s+(?:OF\\s+)?COVERAGE", "NEW\\s+COVERAGE"]},
    "RATING_CHANGE": {"zh": "評等調整報告", "en": "Rating Change", "scope": "COMPANY", "priority": 97, "patterns": ["(?:調升|調降|上調|下調).{0,8}評等", "評等調整", "UPGRADE(?:D)?\\s+TO", "DOWNGRADE(?:D)?\\s+TO", "RATING\\s+CHANGE"]},
    "TARGET_PRICE_CHANGE": {"zh": "目標價調整報告", "en": "Target Price Change", "scope": "COMPANY", "priority": 95, "patterns": ["(?:調升|調降|上調|下調).{0,8}目標價", "目標價調整", "TARGET\\s+PRICE\\s+(?:CHANGE|RAISED|CUT)"]},
    "EARNINGS_PREVIEW": {"zh": "財報前瞻／業績預覽", "en": "Earnings Preview", "scope": "COMPANY", "priority": 98, "patterns": ["財報前瞻", "業績前瞻", "法說前瞻", "EARNINGS\\s+PREVIEW", "RESULTS?\\s+PREVIEW", "PRE[- ]EARNINGS"]},
    "EARNINGS_REVIEW": {"zh": "財報評析／業績回顧", "en": "Earnings Review / Results Review", "scope": "COMPANY", "priority": 98, "patterns": ["財報評析", "業績回顧", "財報回顧", "法說會後", "EARNINGS\\s+(?:REVIEW|RECAP)", "RESULTS?\\s+REVIEW", "POST[- ]EARNINGS"]},
    "MANAGEMENT_MEETING_NOTE": {"zh": "經營階層訪談／公司拜訪紀要", "en": "Management Meeting Note / Company Visit Note", "scope": "COMPANY", "priority": 93, "patterns": ["經營階層訪談", "管理層訪談", "公司拜訪", "拜訪紀要", "MANAGEMENT\\s+(?:MEETING|INTERVIEW)", "COMPANY\\s+VISIT"]},
    "CONFERENCE_CALL_NOTE": {"zh": "法說會／電話會議紀要", "en": "Conference Call Note", "scope": "COMPANY", "priority": 94, "patterns": ["法說會紀要", "電話會議紀要", "CALL\\s+NOTE", "CONFERENCE\\s+CALL\\s+(?:NOTE|TAKEAWAY)"]},
    "INDIVIDUAL_COMPANY_REPORT": {"zh": "個股研究報告", "en": "Company / Equity Research Report", "scope": "COMPANY", "priority": 30, "patterns": ["個股研究", "公司研究", "COMPANY\\s+RESEARCH", "EQUITY\\s+RESEARCH"]},
    "INDUSTRY_RESEARCH": {"zh": "產業研究報告", "en": "Industry Research", "scope": "INDUSTRY", "priority": 70, "patterns": ["產業研究", "行業研究", "INDUSTRY\\s+RESEARCH"]},
    "SECTOR_DEEP_DIVE": {"zh": "產業深度專題", "en": "Sector Deep Dive", "scope": "INDUSTRY", "priority": 83, "patterns": ["產業深度", "行業深度", "SECTOR\\s+DEEP\\s+DIVE", "INDUSTRY\\s+DEEP\\s+DIVE"]},
    "INDUSTRY_OUTLOOK": {"zh": "產業展望", "en": "Industry Outlook", "scope": "INDUSTRY", "priority": 89, "patterns": ["產業.{0,8}(?:展望|前景|前瞻)", "行業.{0,8}(?:展望|前景|前瞻)", "INDUSTRY\\s+OUTLOOK", "SECTOR\\s+OUTLOOK"]},
    "THEMATIC_RESEARCH": {"zh": "主題式研究／專題報告", "en": "Thematic Research", "scope": "THEME", "priority": 68, "patterns": ["主題研究", "專題研究", "THEMATIC\\s+RESEARCH", "THEME\\s+REPORT"]},
    "MACRO_ECONOMIC_REPORT": {"zh": "總體經濟研究報告", "en": "Macroeconomic Research Report", "scope": "MACRO", "priority": 72, "patterns": ["總體經濟", "總經報告", "MACROECONOMIC", "MACRO\\s+(?:RESEARCH|REPORT)"]},
    "ECONOMIC_DATA_COMMENT": {"zh": "經濟數據快評", "en": "Economic Data Comment", "scope": "MACRO", "priority": 86, "patterns": ["經濟數據快評", "數據點評", "ECONOMIC\\s+DATA\\s+(?:COMMENT|FLASH)"]},
    "CENTRAL_BANK_POLICY_NOTE": {"zh": "央行政策／利率決策報告", "en": "Central Bank Policy Note", "scope": "MACRO", "priority": 90, "patterns": ["央行政策", "利率決策", "FOMC.{0,8}(?:點評|紀要|REVIEW|NOTE)", "CENTRAL\\s+BANK\\s+(?:POLICY|NOTE)"]},
    "MARKET_OUTLOOK": {"zh": "市場展望／投資前瞻", "en": "Market Outlook", "scope": "MARKET", "priority": 76, "patterns": ["市場.{0,8}(?:展望|前瞻)", "投資展望", "MARKET\\s+OUTLOOK", "INVESTMENT\\s+OUTLOOK"]},
    "COMPANY_OUTLOOK": {"zh": "公司營運展望", "en": "Company Outlook", "scope": "COMPANY", "priority": 80, "patterns": ["公司.{0,8}(?:展望|前瞻)", "營運展望", "COMPANY\\s+OUTLOOK", "BUSINESS\\s+OUTLOOK"]},
    "ANNUAL_OUTLOOK": {"zh": "年度投資／策略展望", "en": "Annual Investment / Strategy Outlook", "scope": "STRATEGY", "priority": 91, "patterns": ["年度.{0,8}(?:展望|策略)", "全年展望", "ANNUAL\\s+(?:INVESTMENT\\s+|STRATEGY\\s+)?OUTLOOK", "YEAR[- ]AHEAD"]},
    "MID_YEAR_OUTLOOK": {"zh": "年中／下半年投資展望", "en": "Mid-Year / Second-Half Outlook", "scope": "STRATEGY", "priority": 92, "patterns": ["年中展望", "下半年展望", "MID[- ]YEAR\\s+OUTLOOK", "SECOND[- ]HALF\\s+OUTLOOK", "2H\\d{2,4}\\s+OUTLOOK"]},
    "STRATEGY_REPORT": {"zh": "投資策略報告", "en": "Investment Strategy Report", "scope": "STRATEGY", "priority": 65, "patterns": ["投資策略", "市場策略", "INVESTMENT\\s+STRATEGY", "EQUITY\\s+STRATEGY"]},
    "ASSET_ALLOCATION": {"zh": "資產配置報告", "en": "Asset Allocation Report", "scope": "STRATEGY", "priority": 82, "patterns": ["資產配置", "ASSET\\s+ALLOCATION", "CROSS[- ]ASSET"]},
    "WEEKLY_RESEARCH_SUMMARY": {"zh": "研究週報／投資週報", "en": "Weekly Research Summary", "scope": "PERIODIC", "priority": 88, "patterns": ["研究週報", "投資週報", "市場週報", "WEEKLY\\s+(?:RESEARCH|MARKET|INVESTMENT)"]},
    "MONTHLY_INVESTMENT_OUTLOOK": {"zh": "月度投資展望／月報", "en": "Monthly Investment Outlook", "scope": "PERIODIC", "priority": 87, "patterns": ["月度投資展望", "投資月報", "市場月報", "MONTHLY\\s+(?:INVESTMENT\\s+)?OUTLOOK", "MONTHLY\\s+REPORT"]},
    "QUARTERLY_OUTLOOK": {"zh": "季度投資展望", "en": "Quarterly Outlook", "scope": "PERIODIC", "priority": 88, "patterns": ["季度展望", "季投資展望", "QUARTERLY\\s+OUTLOOK"]},
    "IPO_RESEARCH": {"zh": "首次公開發行／新股研究", "en": "IPO Research", "scope": "COMPANY", "priority": 96, "patterns": ["新股研究", "上市前研究", "IPO\\s+(?:RESEARCH|REPORT|NOTE)"]},
    "CREDIT_RESEARCH": {"zh": "信用研究報告", "en": "Credit Research", "scope": "FIXED_INCOME", "priority": 85, "patterns": ["信用研究", "債信研究", "CREDIT\\s+RESEARCH"]},
    "FIXED_INCOME_STRATEGY": {"zh": "固定收益／債券策略", "en": "Fixed Income Strategy", "scope": "FIXED_INCOME", "priority": 84, "patterns": ["固定收益", "債券策略", "FIXED\\s+INCOME\\s+STRATEGY", "BOND\\s+STRATEGY"]},
    "ETF_RESEARCH": {"zh": "ETF 研究報告", "en": "ETF Research", "scope": "FUND", "priority": 78, "patterns": ["ETF.{0,8}(?:研究|報告|評析)", "ETF\\s+RESEARCH"]},
    "QUANTITATIVE_RESEARCH": {"zh": "量化研究／因子研究", "en": "Quantitative / Factor Research", "scope": "QUANT", "priority": 81, "patterns": ["量化研究", "因子研究", "QUANTITATIVE\\s+RESEARCH", "FACTOR\\s+RESEARCH"]},
    "TECHNICAL_ANALYSIS": {"zh": "技術分析報告", "en": "Technical Analysis", "scope": "MARKET", "priority": 75, "patterns": ["技術分析", "TECHNICAL\\s+ANALYSIS", "CHART\\s+BOOK"]},
    "EVENT_DRIVEN_ANALYSIS": {"zh": "事件驅動分析", "en": "Event-Driven Analysis", "scope": "EVENT", "priority": 74, "patterns": ["事件驅動", "突發點評", "EVENT[- ]DRIVEN", "EVENT\\s+COMMENT"]},
    "MERGER_ACQUISITION_NOTE": {"zh": "併購／重組事件報告", "en": "M&A / Restructuring Note", "scope": "EVENT", "priority": 89, "patterns": ["併購", "收購案", "企業重組", "M&A\\s+(?:NOTE|UPDATE)", "MERGER", "ACQUISITION"]},
    "UNCLASSIFIED_RESEARCH": {"zh": "未分類研究文件", "en": "Unclassified Research Document", "scope": "UNKNOWN", "priority": 0, "patterns": []}
  },
  "morning_section_patterns": [
    "(?m)^(?:◆|●|■|\\*|#{1,4})\\s*(?:[\\u4e00-\\u9fffA-Za-z][^\\n]{0,40}?)?\\s*[（(]?\\d{4}[.)）]?[^\\n]*$",
    "(?m)^(?:[一二三四五六七八九十]+|\\d{1,2})[、.]\\s*[^\\n]{2,80}$"
  ]
}
