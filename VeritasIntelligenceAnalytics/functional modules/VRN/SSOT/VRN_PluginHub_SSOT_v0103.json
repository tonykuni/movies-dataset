{
  "ssot": "VIA_VRN_PluginHub_SSOT",
  "version": "v0100",
  "owner_engine": "VRN_ENG397_PluginHub",
  "requirement": "VRN-REQ016",
  "created": "2026-10-01",
  "purpose": "VRN 樂高化外掛中樞:階段(stage)× 積木(provider)註冊表 · 計畫(plan)選積木 · 內部引擎為預設 · 外部工具轉接器執行時偵測(有裝才用、沒裝誠實標 ABSENT 並退回內部積木,中樞**不安裝任何套件**)· AST 盤點每塊積木的函式並給功能分類與說明 · 組出知識物件(Knowledge Object)。",
  "stages": [
    {"id": "render", "zh": "底層渲染", "order": 1, "out": "頁 · 行 · 字級 · 粗體 · bbox · 影像框"},
    {"id": "layout", "zh": "版面切分", "order": 2, "out": "葉區(資訊 / 本文 / 圖 / 排除)· 讀序"},
    {"id": "table", "zh": "表格還原", "order": 3, "out": "表(欄 · 列 · 合併格 · 驗算)"},
    {"id": "text", "zh": "本文還原", "order": 4, "out": "一句一列(編號 · 標題 · 類別)"},
    {"id": "dedup", "zh": "去重修復", "order": 5, "out": "跨頁 / 同頁重複移到排除區"},
    {"id": "completeness", "zh": "截取完整度", "order": 6, "out": "逐字覆蓋率 · 缺字片段"},
    {"id": "title", "zh": "首頁主標題", "order": 7, "out": "主標題(字最大 · 無代號 · 無句號)"},
    {"id": "classify", "zh": "文件分類", "order": 8, "out": "五類 · 信心 · 衝突"},
    {"id": "entities", "zh": "實體", "order": 9, "out": "公司名稱最簡寫 · 目標價本次 / 調整前 · 評價法驗算"},
    {"id": "valuation_lexicon", "zh": "評價法詞庫", "order": 10, "out": "VAL_* 代碼"},
    {"id": "ocr", "zh": "影像 OCR", "order": 11, "out": "影像區文字(只對影像層做)"}
  ],
  "providers": [
    {"id": "int.eng394.restore", "kind": "internal", "module": "VRN_ENG394_LayoutRestore", "call": "restore_pdf", "stages": ["render", "layout", "table", "text", "dedup", "completeness"],
     "desc": "PyMuPDF 行字級 · find_tables 合併格 · XY 切(先左右再上下)· 扁平表還原 · 雙欄頁 · 一句一標題一資料 · 去重 · 完整度"},
    {"id": "int.eng392.coverage", "kind": "internal", "module": "VRN_ENG392_TextCompleteness", "call": "coverage", "stages": ["completeness"],
     "desc": "文字層逐字多重集合覆蓋率(截取完整度的同一把尺)"},
    {"id": "int.eng393.title", "kind": "internal", "module": "VRN_ENG393_DocClassVerify", "call": "page1_title", "stages": ["title"],
     "desc": "首頁主標題:字最大 · 不含股名代碼 · 無句號"},
    {"id": "int.eng393.classify", "kind": "internal", "module": "VRN_ENG393_DocClassVerify", "call": "classify", "stages": ["classify"],
     "desc": "文件五類分類(檔名 + 主標題 · 衝突規則)"},
    {"id": "int.eng395.lexicon", "kind": "internal", "module": "VRN_ENG395_ValuationMethodLexicon", "call": "Matcher", "stages": ["valuation_lexicon"],
     "desc": "評價法 SSOT 比對(繁簡港分欄 · 最長詞優先)"},
    {"id": "int.eng396.entities", "kind": "internal", "module": "VRN_ENG396_ReportEntities", "call": "analyze_pdf", "stages": ["entities"],
     "desc": "公司名稱最簡寫 / 局部識別 · 目標價本次 / 調整前 · 評價法驗算"},
    {"id": "ext.pdfplumber", "kind": "external", "imports": ["pdfplumber"], "pip": "pdfplumber", "stages": ["table"], "adapter": "tables",
     "desc": "向量幾何表格(extract_tables);當第二讀法互核表格數與格值"},
    {"id": "ext.camelot", "kind": "external", "imports": ["camelot"], "pip": "camelot-py", "stages": ["table"], "adapter": "tables",
     "desc": "Lattice / Stream 財報表格"},
    {"id": "ext.tabula", "kind": "external", "imports": ["tabula"], "pip": "tabula-py(需 Java)", "stages": ["table"], "adapter": "tables",
     "desc": "固定版型連續大表"},
    {"id": "ext.docling", "kind": "external", "imports": ["docling"], "pip": "docling", "stages": ["layout", "table"], "adapter": "layout",
     "desc": "DocLayNet 版面 + TableFormer 表格 → Markdown / JSON"},
    {"id": "ext.mineru", "kind": "external", "imports": ["magic_pdf", "mineru"], "pip": "magic-pdf / mineru", "stages": ["layout"], "adapter": "layout",
     "desc": "多欄中英研報版面 · 去浮水印頁碼"},
    {"id": "ext.surya", "kind": "external", "imports": ["surya"], "pip": "surya-ocr", "stages": ["layout", "ocr"], "adapter": "layout",
     "desc": "ViT 版面 · 讀序 · 行級 OCR"},
    {"id": "ext.marker", "kind": "external", "imports": ["marker"], "pip": "marker-pdf", "stages": ["text"], "adapter": "text",
     "desc": "PDF → Markdown(文字層 / 視覺層自動切換)"},
    {"id": "ext.paddleocr", "kind": "external", "imports": ["paddleocr"], "pip": "paddleocr + paddlepaddle", "stages": ["ocr", "table"], "adapter": "ocr",
     "desc": "PP-Structure 中文版面 / 表格 / OCR(依環境計畫裝在自己的 via_ 境)"},
    {"id": "ext.tatr", "kind": "external", "imports": ["transformers", "torch"], "pip": "transformers + torch(+ 模型權重)", "stages": ["table"], "adapter": "tables",
     "desc": "Table Transformer 無框線表格結構(需 GPU / 權重)"},
    {"id": "ext.unstructured", "kind": "external", "imports": ["unstructured"], "pip": "unstructured", "stages": ["layout"], "adapter": "layout",
     "desc": "元素切分(Title / NarrativeText / Table)"},
    {"id": "ext.nougat", "kind": "external", "imports": ["nougat"], "pip": "nougat-ocr", "stages": ["text"], "adapter": "text",
     "desc": "掃描 / 公式頁視覺轉 Markdown(需 GPU;長文易重複幻覺)"},
    {"id": "ext.yolo", "kind": "external", "imports": ["ultralytics"], "pip": "ultralytics(+ DocLayNet 權重)", "stages": ["layout"], "adapter": "layout",
     "desc": "高併發頁面粗切分"},
    {"id": "ext.tesseract", "kind": "external", "imports": ["pytesseract"], "pip": "pytesseract(+ tesseract 執行檔)", "stages": ["ocr"], "adapter": "ocr",
     "desc": "影像層 OCR"}
  ],
  "plans": {
    "default": {"why": "全內部積木(零外部依賴 · 可驗)", "layout": "int.eng394.restore", "title": "int.eng393.title", "classify": "int.eng393.classify",
                "entities": "int.eng396.entities", "xcheck_table": []},
    "xcheck": {"why": "內部為主,外部表格工具有裝就當第二讀法互核(表數 · 格值)", "layout": "int.eng394.restore", "title": "int.eng393.title",
               "classify": "int.eng393.classify", "entities": "int.eng396.entities", "xcheck_table": ["ext.pdfplumber", "ext.camelot"]}
  },
  "rules": {
    "never_install": "中樞只偵測(importlib.util.find_spec)不安裝;要裝外部工具照環境計畫(盤點 → 隔離 → 還原點 → 自測通過才裝)由操作員做",
    "fallback": "計畫指名的外部積木 ABSENT → 退回同階段內部積木,並在知識物件 providers.fallbacks 記一筆(不冒充用過)",
    "xcheck": "外部積木只當第二讀法互核,不覆蓋內部結果;兩法不一致列入 xcheck.diff"
  },
  "ast_categories": [
    {"cat": "自測", "rx": "^selftest$|^_?test"},
    {"cat": "入口", "rx": "^main$|^run_|^cli"},
    {"cat": "輸出", "rx": "markdown|_md$|html|write|export|render_|page_html|payload"},
    {"cat": "去重", "rx": "dedup|duplicate"},
    {"cat": "驗證", "rx": "valid|check|verify|coverage|complete|audit|guard|reject"},
    {"cat": "表格", "rx": "table|cell|merge|grid|column"},
    {"cat": "版面", "rx": "layout|xy_cut|zone|leaf|order|band|page_lines|_inside"},
    {"cat": "分類", "rx": "classif|title|ladder|class|topic"},
    {"cat": "實體", "rx": "identity|mention|company|name|target|price|valuation|entity"},
    {"cat": "擷取", "rx": "extract|parse|read|load|pages|text|token|sentence|match"},
    {"cat": "工具", "rx": "."}
  ],
  "outputs": {"dir": "VIA_Reports/vrn/plugin_hub", "files": ["KO_<檔>.json(知識物件)", "HUB_latest.json", "HUB_latest.html(積木矩陣 · AST 盤點 · 執行摘要)"]}
}
