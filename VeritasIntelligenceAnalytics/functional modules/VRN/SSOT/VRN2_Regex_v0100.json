{
 "book": "VRN2_Regex",
 "owner": "VRN-2",
 "rule": "向其他子系統取用(VRN TW_TICKER_REGEX v2 等)· 不衝突則只增不減 · 本冊為 VRN-2 現役",
 "TW_TICKER": "(?<!\\d)([1-9]\\d{3})(?!\\d)",
 "TW_YFINANCE": "(?<!\\d)([1-9]\\d{3})\\.(TW|TWO)\\b",
 "TW_BLOOMBERG": "(?<!\\d)([1-9]\\d{3})\\s+TT\\b",
 "YEAR": "^(?:FY|CY|年度)?[\\s\\-]?(?:(19|20)?(\\d{2}))\\s*(?:年度?)?\\s*[\\(（]?(?:[AEFPaefp]|實際|預估|Act|Est|F)?[\\)）]?$|^(?:1[0-2])/(\\d{2})[AEFPaefp]?$|^(1[01]\\d)\\s*年[AEFP]?$",
 "MONTH": "^(?:(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\\s\\-/']?(\\d{2,4}))$|^(\\d{4})[\\-/\\.](\\d{1,2})$|^(\\d{2,4})\\s*年\\s*(\\d{1,2})\\s*月$",
 "QUARTER": "^([1-4])Q[\\s\\-]?(\\d{2,4})\\s*[\\(（]?[AEFPaefp]?[\\)）]?$|^(\\d{2,4})Q([1-4])\\s*[\\(（]?[AEFPaefp]?[\\)）]?$|^Q([1-4])[\\s\\-']?(\\d{2,4})$|^(\\d{2,4})\\s*年?\\s*第?([1-4])\\s*季$",
 "DATE": "^(\\d{4})[\\-/\\.](\\d{1,2})[\\-/\\.](\\d{1,2})$|^(\\d{4})(\\d{2})(\\d{2})$|^(\\d{1,2})\\s+(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+(\\d{4})$|^(1[01]\\d)[\\-/\\.](\\d{1,2})[\\-/\\.](\\d{1,2})$|^(\\d{2,4})\\s*年\\s*(\\d{1,2})\\s*月\\s*(\\d{1,2})\\s*日$",
 "NUMBER": "^[\\(（]?[\\-−+]?[\\d,]+(?:\\.\\d+)?[\\)）]?\\s*(%|x|倍|bps|ppts?)?$"
}