  "def_canonical_ids": {
    "def_run_id": {
      "def_formula": "RUN_${YYYYMMDD}_${HHMMSS}_VRN_${RUN_MODE}",
      "def_required_in": ["all_outputs"]
    },
    "def_file_id": {
      "def_formula": "sha12(normalized_source_path + file_size + modified_time + content_sha256)",
      "def_required_in": ["files_registry", "page_blocks", "tables_meta", "tables_long", "text_blocks", "sentences"]
    },
    "def_page_id": {
      "def_formula": "${file_id}::P${page_number_4d}",
      "def_required_in": ["page_blocks", "table_candidates", "tables_meta", "text_blocks", "sentences"]
    },
    "def_sector_id": {
      "def_formula": "${page_id}::S${sector_code}",
      "def_sector_codes": ["FULL", "LEFT", "RIGHT", "MIDDLE", "TOP", "BOTTOM", "FOOTER_EXCLUDED", "HEADER_EXCLUDED"],
      "def_required_in": ["page_blocks", "table_candidates", "tables_meta"]
    },
    "def_table_id": {
      "def_formula": "${file_id}::P${page_number_4d}::${sector_code}::T${table_index_3d}::${content_hash8}",
      "def_required_in": ["tables_meta", "tables_long", "evidence_matrix", "validation_matrix"]
    },
    "def_cell_id": {
      "def_formula": "${table_id}::R${row_index_4d}::C${col_index_4d}",
      "def_required_in": ["tables_long"]
    },
    "def_sentence_id": {
      "def_formula": "${source_object_id}::SENT${sentence_index_5d}",
      "def_required_in": ["sentences"]
    },
    "def_review_id": {
      "def_formula": "REVIEW::${object_type}::${object_id}::${reason_hash8}",
      "def_required_in": ["human_review_queue"]
    }
  },
