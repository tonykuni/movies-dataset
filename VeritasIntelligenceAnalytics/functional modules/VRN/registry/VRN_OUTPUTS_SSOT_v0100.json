  "def_engine_trace_contract": {
    "def_allowed_engines": [
      "pdfplumber",
      "pymupdf",
      "pdfminer_six",
      "camelot",
      "tabula",
      "opencv_grid",
      "tesseract_hocr",
      "paddleocr",
      "easyocr",
      "layoutparser",
      "donut",
      "table_transformer",
      "manual_override"
    ],
    "def_minimum_required_votes_for_table_acceptance": 2,
    "def_confidence_range": {"def_min": 0.0, "def_max": 1.0},
    "def_confidence_bands": {
      "def_high": ">=0.85",
      "def_medium": ">=0.65 and <0.85",
      "def_low": "<0.65"
    },
    "def_review_triggers": [
      "engine_conflict_high",
      "low_confidence",
      "bbox_overlap_conflict",
      "header_shape_mismatch",
      "numeric_type_mismatch",
      "empty_table_after_cleaning",
      "footer_or_appendix_ambiguous",
      "multi_column_order_ambiguous"
    ]
  },
  "def_validation_gates": [
    {
      "def_gate_id": "G001_OUTPUT_PRESENCE",
      "def_priority": "P0",
      "def_pass_condition": "all required outputs exist and are non-empty unless allowed_empty=true",
      "def_fail_blocks_next": true
    },
    {
      "def_gate_id": "G002_SCHEMA_CONTRACT",
      "def_priority": "P0",
      "def_pass_condition": "all canonical Parquet outputs contain required columns and valid primary keys",
      "def_fail_blocks_next": true
    },
    {
      "def_gate_id": "G003_ID_UNIQUENESS",
      "def_priority": "P0",
      "def_pass_condition": "run_id/file_id/table_id/cell_id/sentence_id uniqueness rules pass",
      "def_fail_blocks_next": true
    },
    {
      "def_gate_id": "G004_ROW_COUNT_RECONCILIATION",
      "def_priority": "P0",
      "def_pass_condition": "CSV/JSON exports row counts match Parquet canonical rows",
      "def_fail_blocks_next": true
    },
    {
      "def_gate_id": "G005_DUCKDB_SYNC",
