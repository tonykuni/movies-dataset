      "def_required_columns": ["run_id", "file_id", "page_id", "table_id", "page_number", "sector_code", "table_index", "row_count", "col_count", "header_row_count", "bbox_x0", "bbox_y0", "bbox_x1", "bbox_y1", "engine_winner", "engine_votes_json", "confidence", "status", "review_flag"]
    },
    "vrn_tables_long": {
