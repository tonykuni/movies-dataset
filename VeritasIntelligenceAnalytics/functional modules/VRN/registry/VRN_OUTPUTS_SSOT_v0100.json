    {
      "def_gate_id": "G007_HTML_REPORT_READINESS",
      "def_priority": "P1",
      "def_pass_condition": "HTML report includes status cards, matrices, sample previews, conflict list, and review queue",
      "def_fail_blocks_next": false
    }
  ],
