   "item": "BALANCE_SHEET_PATTERNS.total_equity",
   "regex": "股東權益[合總]計",
   "why": "多數報告的股東權益合計是母公司業主權益；權益總額才含非控制權益（只取『權益總計／總額』）"
  },
  {
   "item": "INCOME_STATEMENT_PATTERNS.gross_profit",
   "regex": "gross\\s*(?:profit|margin)",
   "why": "gross margin 是毛利率，不是毛利"
  },
  {
   "item": "CASH_FLOW_PATTERNS.net_income_cf",
   "why": "名稱寫本期淨利，式子比對的是稅前淨利（上傳檔自己的錯）"
  },
  {
   "item": "CASH_FLOW_PATTERNS.depreciation_amortization",
   "why": "折舊及攤銷合計：AnnualExtract 把 D&A 放在 depreciation，兩邊混用會讓 EBITDA 驗算重複加，所以不對到"
  },
  {
   "item": "PER_SHARE_PATTERNS.dividend_per_share",
   "why": "每股股利含股票股利，和每股現金股利（dps_cash）不同"
  },
  {
   "item": "PER_SHARE_PATTERNS.target_price",
   "why": "不是財報列標（目標價另有冊）"
  },
  {
   "item": "PER_SHARE_PATTERNS.investment_rating",
   "why": "上傳檔把評等當數字（unit=元）；評等照原文顯示不分類"
