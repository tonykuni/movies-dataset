 "operand_patterns": {
  "cash": {
   "from": [
    "InvestmentRegexPattern_VALIDATED.BALANCE_SHEET_PATTERNS.cash（現金及約當現金）"
   ],
   "regex": [
    "現金及約當現金",
    "現金與約當現金",
    "現金及現金等價物",
    "cash\\s*(?:and|&)?\\s*cash\\s*equivalents?",
    "現金(?:$|[^\\u4e00-\\u9fff])"
   ]
  },
  "st_investments": {
   "from": [
    "InvestmentRegexPattern_VALIDATED.BALANCE_SHEET_PATTERNS.short_term_investment（短期投資）"
   ],
   "regex": [
    "(?:透過損益|透過其他綜合損益)按公允價值衡量之金融資產[－—-]?流動",
    "按攤銷後成本衡量之金融資產[－—-]?流動",
    "短期投資",
    "流動金融資產",
    "short[- ]?term\\s*investments?",
    "marketable\\s*securities"
   ]
  },
  "receivables": {
   "from": [
    "InvestmentRegexPattern_VALIDATED.BALANCE_SHEET_PATTERNS.accounts_receivable（應收帳款）"
   ],
   "regex": [
    "應收帳款淨額",
    "應收帳款[－—-]?淨額",
    "應收帳款",
    "accounts?\\s*receivable",
    "trade\\s*receivables?",
    "A/R"
   ]
  },
  "inventory": {
   "from": [
    "InvestmentRegexPattern_VALIDATED.BALANCE_SHEET_PATTERNS.inventory（存貨）"
   ],
   "regex": [
    "存貨淨額",
    "存貨",
    "inventor(?:y|ies)"
   ]
  },
  "prepaid": {
   "from": [
    "InvestmentRegexPattern_VALIDATED.BALANCE_SHEET_PATTERNS.prepaid_expenses（預付款項）"
   ],
   "regex": [
    "預付款項",
    "預付費用",
    "預付貨款",
    "prepaid\\s*(?:expenses?|items?)"
   ]
  },
  "current_assets": {
   "from": [
    "InvestmentRegexPattern_VALIDATED.BALANCE_SHEET_PATTERNS.total_current_assets（流動資產合計）"
   ],
   "regex": [
    "流動資產[合總]計",
    "流動資產小計",
    "total\\s*current\\s*assets?"
   ]
  },
  "lt_investments": {
   "from": [
    "InvestmentRegexPattern_VALIDATED.BALANCE_SHEET_PATTERNS.long_term_investment（長期投資）"
   ],
   "regex": [
    "採用權益法之投資",
    "長期股權投資",
    "長期投資",
    "(?:透過損益|透過其他綜合損益)按公允價值衡量之金融資產[－—-]?非流動",
    "long[- ]?term\\s*investments?",
    "equity\\s*method\\s*investments?"
   ]
  },
  "ppe": {
   "from": [
    "InvestmentRegexPattern_VALIDATED.BALANCE_SHEET_PATTERNS.property_plant_equipment（不動產廠房及設備）"
   ],
   "regex": [
    "不動產[、,]?廠房及設備淨額",
    "不動產[、,]?廠房及設備",
    "固定資產淨額",
    "固定資產",
    "property[,\\s]*plant\\s*(?:and|&)\\s*equipment",
    "PP&?E",
    "PPE"
   ]
  },
  "rou": {
   "from": [
    "InvestmentRegexPattern_VALIDATED.BALANCE_SHEET_PATTERNS.right_of_use_assets（使用權資產）"
   ],
   "regex": [
    "使用權資產",
    "right[- ]?of[- ]?use\\s*assets?",
    "ROU\\s*assets?"
   ]
  },
  "inv_property": {
   "from": [
    "InvestmentRegexPattern_VALIDATED.BALANCE_SHEET_PATTERNS.investment_property（投資性不動產）"
   ],
   "regex": [
    "投資性不動產",
    "investment\\s*property"
   ]
  },
  "intangibles": {
   "from": [
    "InvestmentRegexPattern_VALIDATED.BALANCE_SHEET_PATTERNS.intangible_assets（無形資產）"
   ],
   "regex": [
    "無形資產",
    "intangible\\s*assets?"
   ]
  },
  "dta": {
   "from": [
    "InvestmentRegexPattern_VALIDATED.BALANCE_SHEET_PATTERNS.deferred_tax_assets（遞延所得稅資產）"
