 "tolerance": {
  "rule": "VRN_Method_SSOT_v0100.json def15_tolerance：Tol = max(絕對容差, 相對容差 × max(|A|,|B|))；差 ≤ Tol = PASS，≤ 3×Tol = WARN，> 3×Tol = FAIL。絕對容差至少是印出來的位數造成的四捨五入（每個運算元 0.5 × 最後一位）",
  "by_kind": {
   "amount": {
    "rel": 0.01
   },
   "pct": {
    "abs": 0.5
   },
   "ratio": {
    "rel": 0.03
   },
   "per_share": {
    "rel": 0.03
   },
   "multiple": {
    "rel": 0.03
   },
   "days": {
    "rel": 0.03
   }
  },
  "from_field_rules": "GP_SUB / OP_SUB 相對 2%、BS_ADD 1%、毛利率類 0.5 個百分點、EPS 3%（VRN_FieldRules_SSOT_v0101.json rules.financial.verify.identities）——同 id 照那本冊",
  "approx": "approx = 冊上的式子用平均數（ROE、ROA、週轉率），表上只有期末數時差異照列，最多 WARN，不判 FAIL",
  "unit_scale": "比率差 100 倍（40 vs 0.40）= UNIT_SCALE；每股、股數類差 10 的次方 = UNIT_SCALE ×k，照列不改"
 },
