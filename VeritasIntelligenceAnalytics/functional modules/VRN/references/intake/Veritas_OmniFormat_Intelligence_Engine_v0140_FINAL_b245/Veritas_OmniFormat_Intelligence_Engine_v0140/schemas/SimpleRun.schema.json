{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritas.local/schemas/vofie-simple-run-1.1.json",
  "title": "VOFIE Simple Five Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "inputs", "output", "role", "operations"],
  "properties": {
    "contract": {"const": "veritas.vofie-simple-run/1.1"},
    "inputs": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "output": {"type": "string", "minLength": 1},
    "role": {"enum": ["ENGINE", "SYSTEM"]},
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["text_merge", "code_merge", "restructure", "deduplicate", "optimize"]}
    },
    "title": {"type": "string"},
    "language": {"enum": ["zh-Hant", "zh-Hans", "en", "auto"]},
    "use_vsis": {"type": "boolean"},
    "primary_outputs": {"const": ["md", "html", "component_json", "docx", "csv"]}
  }
}
