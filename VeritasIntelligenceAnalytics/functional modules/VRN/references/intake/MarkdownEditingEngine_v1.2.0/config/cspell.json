{
"version": "0.2",
"language": "en,en-GB",
"useGitignore": true,
"caseSensitive": false,
"enableGlobDot": true,
"ignorePaths": [
"**/node_modules/**",
"**/.venv/**",
"**/reports/**",
"**/.markdown-editing-backup/**",
"**/book-output/**"
],
"words": [
"callout",
"callouts",
"CNYES",
"CSpell",
"frontmatter",
"GFM",
"mdast",
"mdBook",
"mdlinkcheck",
"mdscan",
"mdformat",
"MarkdownEditingEngine",
"markdownlint",
"mdit",
"Pandoc",
"PowerShell",
"Prettier",
"Prettydiff",
"PyMarkdown",
"quarantine",
"remark",
"rumdl",
"SSOT",
"strikethrough",
"TWSE",
"TPEX",
"venv",
"YFinance"
]
}
