{
"config": {
"default": true,
"MD013": false,
"MD024": { "siblings_only": true },
"MD025": false,
"MD033": false,
"MD034": false,
"MD041": false,
"MD046": { "style": "fenced" },
// CJK display width differs between formatters. Structural column counts are
// enforced by semantic-reconstruction, so visual padding is non-blocking.
"MD060": false
},
"ignores": [
"**/node_modules/**",
"**/.venv/**",
"**/book/**",
"**/reports/**",
"**/.markdown-editing-backup/**"
]
}
