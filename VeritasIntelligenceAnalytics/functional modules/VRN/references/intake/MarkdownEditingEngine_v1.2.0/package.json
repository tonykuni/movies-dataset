{
  "name": "markdown-editing-engine",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "doctor": "python engine/markdown_engine.py doctor",
    "test:python": "python -m unittest discover -s tests -p 'test_*.py' -v",
    "test:node": "node --test tests/node.test.mjs",
    "test:cspell": "cspell lint --config config/cspell.json README.md RECONSTRUCTION_GUIDE.md THIRD_PARTY.md TEST_REPORT.md tests/**/*.md"
  },
  "devDependencies": {
    "cspell": "9.8.0",
    "github-slugger": "2.0.0",
    "markdownlint-cli2": "0.23.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-to-markdown": "2.1.2",
    "prettier": "3.9.6",
    "prettier-plugin-lint-md": "1.0.3",
    "remark-cli": "12.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-lint-no-undefined-references": "5.0.2",
    "remark-parse": "11.0.0",
    "remark-preset-lint-recommended": "7.0.1",
    "unified": "11.0.5"
  }
}
