      "tpex": "https://mopsfin.twse.com.tw/opendata/t187ap05_O.csv",
      "existing_canonical": "dict/VDF/DATABASE/VDF_TW_MonthlyRevenue.parquet",
      "priority": [
        "latest official MOPS snapshot",
        "existing VDF canonical"
      ]
    },
    "company_master": {
