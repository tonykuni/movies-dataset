    "hhi_revenue_concentration",
    "top5_revenue_concentration",
    "rotation_score",
    "rotation_rank",
    "phase",
    "phase_age_months",
    "phase_confidence",
    "rotation_state"
  ],
  "phase_model": {
    "method": "dynamic_cross_sectional_percentile_plus_absolute_direction",
    "rotation_score_weights": {
      "yoy_percentile": 0.35,
      "mom_percentile": 0.20,
      "acceleration_percentile": 0.25,
      "breadth_percentile": 0.15,
      "new_high_percentile": 0.05
    },
    "high_percentile": 0.70,
    "low_percentile": 0.30,
    "minimum_positive_breadth": 0.50,
    "strong_breadth": 0.60,
    "phase_values": [
      "LEADING_ACCELERATION",
      "EXPANDING",
      "RECOVERING",
      "MIXED",
      "DECELERATING",
      "CONTRACTING",
      "INSUFFICIENT_HISTORY"
    ],
    "rotation_states": [
      "LEADER",
      "IMPROVING",
      "PEER",
      "WEAKENING",
      "LAGGER"
    ]
  },
  "cross_analysis": {
    "pairwise_matrix": [
      "yoy_gap_pp",
      "mom_gap_pp",
      "acceleration_gap_pp",
      "breadth_gap_pp",
      "rotation_score_gap",
      "dominant_dimension",
      "dominance_strength"
    ],
    "lead_lag": {
      "definition": "corr(A[t], B[t+L]); L > 0 means A leads B",
      "minimum_observations": 18,
      "maximum_lag_months": 6
    },
    "industry_group_bridge": [
      "weighted_revenue",
      "share_of_industry",
      "share_of_group",
      "industry_group_yoy_pct"
    ]
  },
  "outputs": {
    "csv_encoding": "utf-8-sig",
    "parquet_required_in_production": true,
    "duckdb_required_in_production": true,
    "tables": [
