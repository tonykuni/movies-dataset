      "period",
      "ticker",
      "market"
    ],
    "company_group_key": [
      "period",
      "ticker",
      "group"
    ],
    "dedup_policy": "source_priority_then_fetched_at_keep_latest",
    "history_policy": "incremental_merge_no_silent_overwrite",
    "missing_revenue_policy": "retain_and_flag_never_forward_fill",
    "multi_group_policy": "weights_per_ticker_must_sum_to_one",
    "group_fallback_policy": "industry_as_proxy_group_with_explicit_proxy_flag",
    "fail_closed": [
      "empty canonical result",
      "invalid period",
      "duplicate canonical key",
      "multi-group weights not equal to one",
      "weighted group revenue does not reconcile",
      "required Parquet engine unavailable",
      "required DuckDB engine unavailable"
