   "name_zh": "簡單移動平均",
   "name_en": "Simple Moving Average",
   "formula": "SMA_n(t) = mean(p_{t-n+1..t})",
   "params": [
    "S1 strict_window:未滿 n 或視窗內有 null 則 null",
