{
  "schema": "VIA-ENGINE-REGISTRY/1.0",
  "engine": {
    "id": "VDF_ENG_TALIB_ONE",
    "name": "VIA TA-Lib OneEngine",
    "version": "1.0.0",
    "kind": "ENGINE",
    "module": "VDF",
    "owner": "VDF Feature Layer",
    "entrypoint": "VIA_TALib_OneEngine.py",
    "launcher": "Invoke-VIA-TALib-OneEngine.ps1",
    "status": "ACTIVE_CANONICAL"
  },
  "contracts": {
    "input": "VDF normalized market data or downloaded OHLCV/activity data",
    "output": "Date+Ticker wide feature table, feature registry, signal table, VAP catalog and manifest",
    "connection_manifest": "VIA-VDF-VAP-CONNECTION-MANIFEST/1.0",
    "source_access": "READ_ONLY",
    "price_policy": "ADJUSTED_PRICE_ONLY",
    "grain": ["date", "ticker"],
    "volume_policy": "raw and ex_daytrade are separate, selectable and never silently substituted"
  },
  "parameter_policy": {
    "generic_periods": [5, 10, 20, 60, 120, 240],
    "special_presets_source": "VIA_TALib_OneEngine.config.json",
    "runtime_catalog": "TA-Lib Abstract API",
    "all_defaults_visible_and_editable": true
