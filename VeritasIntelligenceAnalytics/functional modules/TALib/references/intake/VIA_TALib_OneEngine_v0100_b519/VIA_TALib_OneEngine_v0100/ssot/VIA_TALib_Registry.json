  "legacy_consolidation": {
    "source_engine": "VIA_ENG003_TALibEngine.py v0100",
    "source_capability": "64 registered patterns/indicators with native fallback",
    "retained": ["classification SSOT", "signal thresholds", "sample/self-test", "VAP bridge intent", "CSV/JSON/SQLite/DuckDB inputs"],
    "replaced": ["hard-coded partial registry", "silent native fallback", "raw-price fallback for securities", "single global period override"],
    "runtime_rule": "only VDF_ENG_TALIB_ONE computes indicators"
  },
  "governance": {
    "ssot": true,
    "registry_identity": ["Database", "Table", "Field", "Version"],
    "zero_hydra": "one calculation entrypoint; VAP consumes catalog and does not recalculate",
    "incremental_output": "Date+Ticker deduplicate, current calculation wins",
    "errors": "recorded per ticker/function/variant/volume basis"
  }
