{
  "_meta": {
    "schema": "VIA-FORGE-CONFIG",
    "version": "1.0.0",
    "governance": "append-only (只增不減)",
    "encoding": "UTF-8 no-BOM",
    "note": "Single Source of Truth for via_forge.py. Engines never hardcode."
  },
  "paths": {
    "root": "C:\\VeritasIntelligenceAnalytics\\VeritasDataForge\\Forge",
    "root_fallback": "AUTO",
    "inbox": "{root}\\inbox",
    "runtime": "{root}\\runtime",
    "ledger": "{root}\\runtime\\ledger",
    "cache": "{root}\\runtime\\cache",
    "output": "{root}\\output",
    "reports": "{root}\\output\\reports",
    "exports": "{root}\\output\\exports",
    "logs": "{root}\\runtime\\logs",
    "quarantine": "{root}\\runtime\\quarantine",
    "venv": "C:\\Users\\tonyk\\envs\\via_forge",
    "ui": "{root}\\ui",
    "temp": "{root}\\runtime\\cache/temp",
    "base": "C:\\VeritasIntelligenceAnalytics\\VeritasDataForge\\Forge"
  },
  "environment": {
    "python_preferred": "3.12",
    "python_fallbacks": [
      "3.12",
      "3.11",
      "3.13"
    ],
    "venv_name": "via_forge",
    "auto_create_venv": true,
    "auto_install_deps": true,
    "numpy_pin": ">=1.24,<2.0",
    "packages_required": [],
    "packages_optional": [
      "python-docx",
      "openpyxl",
      "pandas",
      "python-pptx",
      "pypdf",
      "pikepdf",
      "charset-normalizer",
      "striprtf",
      "odfpy",
      "beautifulsoup4",
      "extract-msg",
      "pillow",
      "pytesseract",
      "jieba",
      "opencc-python-reimplemented",
      "rich",
      "google-auth-oauthlib",
      "google-api-python-client",
      "msal",
      "pywin32"
    ],
    "packages_banned": [
      "uvloop"
    ],
    "system_tools_optional": [
      "tesseract-ocr",
      "libreoffice"
    ]
  },
  "accelerator": {
    "lazy_import": true,
    "memo_cache_enabled": true,
    "memo_cache_max_entries": 4096,
    "disk_cache_enabled": true,
    "disk_cache_ttl_hours": 168,
    "hash_chunk_bytes": 1048576,
    "bloom_size": 262144,
    "bloom_hashes": 5,
    "parallel_enabled": true,
    "parallel_workers": "AUTO",
    "parallel_max_workers": 8,
    "parallel_min_files": 12,
    "parallel_mode": "thread",
    "progress_marker": "@@PROGRESS|{pct}|{label}",
    "progress_stream": "stderr"
  },
  "readers": {
    "extract_limit": 8000,
    "text_preview_chars": 400,
    "encoding_probe_order": [
      "utf-8-sig",
      "utf-8",
      "big5",
      "cp950",
      "latin-1"
    ],
    "skip_hidden": true,
    "skip_dirs": [
      "$RECYCLE.BIN",
      ".git",
      ".pytest_cache",
      ".svn",
      ".venv",
      "VIA_RUNS",
      "__pycache__",
      "backup",
      "build",
      "dist",
      "node_modules"
    ],
    "max_file_mb": 128
  },
  "textlab": {
    "enabled": true,
    "normalize_fullwidth_ascii": true,
    "opencc_convert": true,
    "opencc_profile": "s2twp",
    "sentence_split": true,
    "decimal_point_protect": true,
    "keyword_engine": "jieba_tfidf",
    "keyword_fallback": "frequency",
    "keyword_topk": 12
  },
  "classify": {
    "enabled": true,
    "classify_on": "corrected_text",
    "registry_file": "via_forge_registry.json",
    "unmatched_label": "GENERAL"
  },
  "pii": {
    "enabled": true,
    "auto_escalate_sensitivity": true,
    "levels": [
      "PUBLIC_OR_UNMARKED",
      "INTERNAL",
      "CONFIDENTIAL"
    ]
  },
  "evidence": {
    "tiers": {
      "M": "file-verified",
      "P": "pending",
      "Est": "estimated"
    },
    "default": "Est"
  },
  "ids": {
    "format": "VIA-DOC-{YYYYMMDD}-{SEQ:06d}-{HASH}",
    "hash_algo": "blake2s",
    "hash_digest_bytes": 3,
    "hash_case": "upper"
  },
  "ledger": {
    "enabled": true,
    "mode": "append_only",
    "format": "jsonl",
    "file": "forge_ledger.jsonl",
    "encoding": "utf-8",
    "bom": false,
    "never_delete": true
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8780,
    "port_fallback_range": [
      8780,
      8800
    ],
    "bind_note": "loopback only",
    "open_browser": true,
    "shutdown_endpoint": true,
    "max_upload_mb": 128
  },
  "export": {
    "formats": [
      "json",
      "csv",
      "xlsx",
      "html"
    ],
    "default": "html",
    "html_report_name": "forge_report.html",
    "xlsx_report_name": "forge_records.xlsx"
  },
  "visual_lock": {
    "bg": "#f5f4f0",
    "paper": "#ffffff",
    "ink": "#1e1d1a",
    "line": "#dbd9d3",
    "blue": "#4c78a8",
    "teal": "#439a9a",
    "up_red": "#c96b5a",
    "down_green": "#5a9e6f",
    "font_display": "Syne",
    "font_body": "DM Sans",
    "font_mono": "DM Mono",
    "radius_px": 3,
    "seal": "庫",
    "sub_ink": "#6b6a66",
    "grey": "#9c9890",
    "surface2": "#faf9f6",
    "surface3": "#faf9f4",
    "surface4": "#eceae2",
    "amber": "#c4943a",
    "gold": "#c9b05a",
    "seal_red": "#b5291a",
    "font_body_cjk": "Noto Sans TC",
    "resonance_gradient": "linear-gradient(90deg,#4c78a8,#439a9a,#c9b05a,#c96b5a)",
    "radius": {
      "sharp": 2,
      "sm": 3,
      "md": 4,
      "seal": 7,
      "card": 8,
      "pill": 9
    },
    "stylesheet": "visual_lock.css",
    "template": "VIA_VisualLock_Template.html",
    "source": "VIA_TW_ETF_Group_Console.html (Tony 上傳 2026-07)",
    "seals": {
      "platform": "臺",
      "VDF": "庫",
      "VRN": "牘",
      "VAP": "觀",
      "VPNS": "輔",
      "governance": "綱",
      "central": "理",
      "mailforge": "牡",
      "panorama": "觀"
    }
  },
  "governance": {
    "append_only": true,
    "no_delete": true,
    "no_network_egress": true,
    "network_note": "local/authorized disk only; Google/Outlook pull = stage-2 OAuth connector",
    "audit_every_action": true
  },
  "connect": {
    "enabled": true,
    "ledger_file": "connect_ledger.jsonl",
    "default_query": {
      "gmail": "newer_than:7d",
      "drive": "mimeType='application/vnd.google-apps.document'",
      "outlook": "",
      "local_outlook": ""
    },
    "google": {
      "client_secret_file": "client_secret.json"
    },
    "outlook": {
      "client_id": "<YOUR_AZURE_APP_CLIENT_ID>",
      "authority": "https://login.microsoftonline.com/common"
    },
    "local_outlook": {
      "days_back": 7,
      "note": "讀取使用者本人本機 Outlook 收件匣 (COM)；繼承登入身分；不存密碼；Windows-only。若公司環境請透明使用。"
    },
    "governance": {
      "scopes_readonly_only": true,
      "delegated_only": true,
      "note": "僅自己帳號、自己授權；readonly scope；不寫不刪不發；不做監控規避。token 存本機。"
    }
  },
  "pmine": {
    "enabled": true,
    "top_k_variants": 10,
    "evolve_threshold": 3,
    "evolve_registry": "pmine_evolve.jsonl",
    "stake_registry": "stakeholders.jsonl",
    "stake_context": "Electronics",
    "ssot_uid_field": "doc_id",
    "note": "事件日誌/控管表/流程探勘/SSOT/利害關係人；規則演化只新增不刪除 (只增不減)"
  },
  "sink": {
    "enabled": true,
    "default_formats": [
      "json",
      "parquet",
      "duckdb",
      "csv",
      "html"
    ],
    "duckdb_table": "via_records",
    "duckdb_mode": "append_only_upsert",
    "gsheet_push": false,
    "note": "作業中 JSON；匯出多重 sink。DuckDB 為顯式匯出交付物，append-only upsert (依 doc_id)，不在掃描中途寫 DB。"
  }
}