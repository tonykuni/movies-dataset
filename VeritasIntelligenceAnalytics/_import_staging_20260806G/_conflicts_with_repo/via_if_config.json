  "module_bindings": {
    "fetch_engine": {
      "role": "fetch_engine",
      "path": "functional modules\\Invoke-VeritasCodexNexus.ps1",
      "kind": "powershell",
      "invoke_template": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"{path}\" -OutputRoot \"{out}\"",
      "execute_in_p1": false,
      "note": "P2 fill exact param block before enabling execution"
    },
    "nexus_core": {
      "role": "fetch_support",
      "path": "supportive modules\\Invoke-VeritasNexusCore.ps1",
      "kind": "powershell",
      "execute_in_p1": false
    },
    "ssot_core": [
      { "role": "ssot_core", "path": "supportive modules\\VIA_SSOT_Unified.py", "kind": "python" },
      { "role": "ssot_core", "path": "supportive modules\\VIA_RegistryCore_v1.py", "kind": "python" }
    ],
    "governance": { "role": "governance", "path": "supportive modules\\Invoke-VIA-CentralGovernanceManager.ps1", "kind": "powershell", "execute_in_p1": false },
    "env_manager": { "role": "env_manager", "path": "supportive modules\\VIA_EnvManager.py", "kind": "python", "execute_in_p1": false },
    "runtime_bridge": { "role": "runtime_bridge", "path": "supportive modules\\VIA_Runtime_Bridge_All_in_One.py", "kind": "python", "execute_in_p1": false },
    "ast_injector": { "role": "ast_injector", "path": "supportive modules\\VIA_Panorama_AST_RuntimeInjector.py", "kind": "python", "execute_in_p1": false },
    "registries": [
      "supportive modules\\schema_registry.json",
      "supportive modules\\chartspec_registry.json",
      "supportive modules\\unified_veritas_data.json"
    ]
  },
  "opex_policy": {
    "default_profile": "Conservative",
    "profiles": {
      "Strict-Conservative": { "buffer": 0.04, "stickiness": 0.60, "revenue_percentile": 0.25, "cost_percentile": 0.75, "warn_optimistic": false },
      "Conservative":        { "buffer": 0.02, "stickiness": 0.50, "revenue_percentile": 0.35, "cost_percentile": 0.65, "warn_optimistic": false },
      "Neutral":             { "buffer": 0.00, "stickiness": 0.40, "revenue_percentile": 0.50, "cost_percentile": 0.50, "warn_optimistic": true }
    },
    "default_beta": { "selling": 0.55, "rnd": 0.40, "ga": 0.30 },
    "gate": { "pass": "ratio_ge_hist_median", "warn": "ratio_lt_hist_p10", "flag": "ratio_gt_hist_p90" },
    "winsorize": 0.10,
    "min_history_years": 3,
    "house_rule": "never_more_optimistic_than_consensus_without_evidence"
  },
