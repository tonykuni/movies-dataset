  "def_score_scaling": {
    "z_method": "robust_mad",
    "z_note": "robust_z = (x - median) / (1.4826 * MAD)，與 MDL008 FIS 同式",
    "z_lookback_days": 252,
    "z_clip": 3.0,
    "fis_formula": "fis = 100 * tanh(mean(component_z * weight) / 2)  → ±100",
    "risk_formula": "risk_0_100 = 50 + fis / 2",
    "bands": [
      { "id": "low",     "max": 30,  "label": "Low",     "label_zh": "低",   "status": "good" },
      { "id": "medium",  "max": 60,  "label": "Medium",  "label_zh": "中",   "status": "warning" },
      { "id": "high",    "max": 80,  "label": "High",    "label_zh": "高",   "status": "serious" },
      { "id": "extreme", "max": 100, "label": "Extreme", "label_zh": "極端", "status": "critical" }
    ]
  },

