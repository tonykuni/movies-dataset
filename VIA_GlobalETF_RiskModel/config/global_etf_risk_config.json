    "market_overlay": { "etf_ret_window": 20 },
    "bands": [
      { "id": "resilient", "max": 30,  "label_zh": "穩健", "status": "good" },
      { "id": "watch",     "max": 55,  "label_zh": "觀察", "status": "warning" },
      { "id": "fragile",   "max": 75,  "label_zh": "脆弱", "status": "serious" },
      { "id": "critical",  "max": 100, "label_zh": "危險", "status": "critical" }
    ]
  },

  "def_output": {
    "run_prefix": "RUN",
    "run_suffix": "VIA_GLOBAL_ETF_RISK",
    "files": [
      "scores.json", "regime.json", "rotation.json", "sync.json",
