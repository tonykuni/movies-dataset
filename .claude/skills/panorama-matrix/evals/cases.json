{
  "skill": "panorama-matrix",
  "runner": "python3 .claude/skills/panorama-matrix/evals/run_evals.py",
  "note": "E1–E5、E7 由 run_evals.py 實跑;E6 是觸發描述案例,給 skill-creator 的描述最佳化迴圈用(尚未跑)。首輪棘輪必為 NODATA(結束碼 2),所以 E1 跑兩輪,第二輪才要求 rc 0。",
  "cases": [
    {"id": "E1", "fixture": "fixtures/clean", "args": ["--profile", "via-verb-engine", "--no-git"], "runs": 2,
     "expect": {"rc_first": 2, "rc_second": 0, "verdict_second": "GREEN", "files": 20, "families": 3,
                "quarantine_rows_all": "HOLD", "q1_q4": "GREEN", "target_mtime_unchanged": true}},
    {"id": "E2", "fixture": "(runtime) 本機 git 倉領先 2 · 落後 3", "args": ["--profile", "generic"],
     "expect": {"ahead": 2, "behind": 3, "tail_diff": 1, "reflog_unchanged": true, "rc": 2}},
    {"id": "E3", "fixture": "fixtures/quarantine-bad", "args": ["--profile", "via-verb-engine", "--no-git"],
     "expect": {"Q1": "RED", "Q3": "RED", "no_quarantine_green": true, "rc": 1}},
    {"id": "E4", "fixture": "(runtime) 語法錯 2 檔 → 4 檔", "args": ["--profile", "generic", "--no-git", "--static"],
     "expect": {"G": "RETROGRESS", "rc": 1, "ledger_lines": 2}},
    {"id": "E5", "fixture": "fixtures/clean(模擬沒裝 rich)", "args": ["--profile", "via-verb-engine", "--no-git", "--rich"],
     "expect": {"outputs": ["panorama_latest.html", "panorama_latest.txt", "panorama_latest.json", "universal_ledger.jsonl"], "rc": 2}},
    {"id": "E6", "kind": "trigger",
     "should_trigger": ["盤點這個倉現況", "全景一下 C:\\x", "隔離區對不對", "這輪有沒有退步", "產出矩陣報告給我看 GitHub 上 tonykuni/movies-dataset 的現況",
                        "監測不動作,看一下鎖跟帳本"],
     "should_not_trigger": ["幫我修這個錯", "重構這個模組", "跑測試", "把加速器橋注入缺的檔"]},
    {"id": "E7", "kind": "consistency", "expect": {"skill_profiles_equal_engine_sidecar": true, "card_max_lines": 15}}
  ]
}
