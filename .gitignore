# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# VIA products (rebuilt on demand; engines + QA evidence are tracked instead)
# VDF analytical database — rebuild with:
#   python "VeritasIntelligenceAnalytics/functional modules/VDF/engine/vdf_movies_intake_v001.py" --base VeritasIntelligenceAnalytics
VeritasIntelligenceAnalytics/functional modules/VDF/db/
# VeritasAutoPlot chart output — rebuild with:
#   python "VeritasIntelligenceAnalytics/functional modules/VAP/engine/via_autoplot_engine_v001.py" --base VeritasIntelligenceAnalytics --auto
VeritasIntelligenceAnalytics/VAP/output/
VeritasIntelligenceAnalytics/functional modules/VRN/__pycache__/

# --- VIA standard six-slot layout (2026-08-02) ---
VeritasIntelligenceAnalytics/functional modules/*/temp/*
!VeritasIntelligenceAnalytics/functional modules/*/temp/.gitkeep
VeritasIntelligenceAnalytics/functional modules/*/output/*
!VeritasIntelligenceAnalytics/functional modules/*/output/.gitkeep
VeritasIntelligenceAnalytics/functional modules/*/db/*
!VeritasIntelligenceAnalytics/functional modules/*/db/.gitkeep
VeritasIntelligenceAnalytics/functional modules/VRN/input/*
!VeritasIntelligenceAnalytics/functional modules/VRN/input/.gitkeep
!VeritasIntelligenceAnalytics/functional modules/VRN/input/incoming/
VeritasIntelligenceAnalytics/functional modules/VRN/input/incoming/*
!VeritasIntelligenceAnalytics/functional modules/VRN/input/incoming/.gitkeep

